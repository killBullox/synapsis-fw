# Credenziali FTP per deploy automatico su Aruba Hosting Easy Linux.
# Copia questo file in `.env.deploy` (NON committato) e compila con i tuoi valori.
# Le credenziali si trovano nel pannello Aruba → "Gestione FTP" o "Account FTP".

FTP_HOST=ftp.synapsisfw.it
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21

# Cartella remota dove caricare il sito.
# Su Aruba Hosting Easy Linux è quasi sempre /htdocs (root del sito web).
FTP_REMOTE_DIR=/htdocs

# FTPS esplicito (TLS sopra FTP). Aruba supporta sia FTP che FTPS.
# Per più sicurezza imposta a true (porta resta 21, ma con TLS).
FTP_SECURE=false
