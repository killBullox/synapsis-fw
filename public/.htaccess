# =============================================================================
# Synapsis FW — Apache config per Aruba Hosting Easy Linux
# =============================================================================

# UTF-8 default per file di testo
AddDefaultCharset UTF-8

# Priorità index.html (sovrascrive l'index.php di default Aruba)
DirectoryIndex index.html index.htm index.php

# -----------------------------------------------------------------------------
# 1. HTTPS forced + redirect www → non-www
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # NOTA: Aruba forza www lato server, quindi NON facciamo redirect www→non-www
  # Il dominio canonical è www.synapsisfw.it

  # Trailing slash per directory (Astro genera /privacy/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# -----------------------------------------------------------------------------
# 2. Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS — forza HTTPS sui browser per 1 anno (rimuovi includeSubDomains se hai sottodomini http)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # MIME sniffing off
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy (disabilita feature non usate)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Cross-Origin policies (compatibili con Google Fonts e Web3Forms)
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Rimuovi server info
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# 3. Compressione gzip (mod_deflate)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf font/woff font/woff2
</IfModule>

# -----------------------------------------------------------------------------
# 4. Cache control per asset statici
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — sempre fresco (no cache aggressiva, così deploy nuovi sono visibili subito)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS / JS — 1 anno (Astro hash i file, perfetti per cache lunga)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Immagini
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType video/webm "access plus 6 months"

  # Font
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # Sitemap / robots — 1 giorno
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"

  # Default fallback
  ExpiresDefault "access plus 1 month"
</IfModule>

# -----------------------------------------------------------------------------
# 5. MIME types extra (alcuni server Aruba potrebbero non averli)
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# 6. Pagina 404 custom
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# 7. Blocca accessi a file sensibili
# -----------------------------------------------------------------------------
<FilesMatch "^\.(env|gitignore|htaccess|htpasswd)$|.*\.(bak|log|md)$">
  Require all denied
</FilesMatch>

# Disabilita listing directory
Options -Indexes

# NOTA: la protezione delle cartelle /area-riservata/ e /en/private-area/
# è gestita dai file .htaccess locali dentro quelle cartelle (HTTP Basic Auth).
