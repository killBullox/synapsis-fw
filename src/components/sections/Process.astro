---
import SectionHeader from '@components/SectionHeader.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [0, 1, 2, 3].map((i) => ({
  title: t(`process.steps.${i}.title` as any),
  body: t(`process.steps.${i}.body` as any),
}));

const tags = [
  lang === 'it' ? 'Briefing gratuito' : 'Free briefing',
  lang === 'it' ? 'Multidisciplinare' : 'Multidisciplinary',
  lang === 'it' ? 'Fee Waiver attivo' : 'Fee Waiver active',
  lang === 'it' ? 'Certificato' : 'Certified',
];
---

<section
  id="processo"
  class="relative overflow-hidden bg-brand-ink py-section text-brand-paper md:py-32"
>
  <div class="container-page">
    <SectionHeader
      eyebrow={t('process.eyebrow')}
      title={t('process.title')}
      tone="ink"
    />

    <div class="relative mt-20 md:mt-28">
      <!-- Linea verticale (desktop) / nascosta su mobile -->
      <div class="absolute left-6 top-0 hidden h-full w-px bg-brand-paper/15 md:left-1/2 md:block">
        <div
          class="absolute inset-x-0 top-0 w-px bg-brand-orange origin-top scale-y-0"
          data-process-line
        ></div>
      </div>

      <ol class="space-y-12 md:space-y-20">
        {steps.map((step, i) => (
          <li class={`reveal relative grid gap-6 md:grid-cols-2 md:gap-16 ${i % 2 === 1 ? 'md:[&>div:first-child]:order-2' : ''}`}>
            <!-- Step number side -->
            <div class={`relative ${i % 2 === 0 ? 'md:text-right md:pr-12' : 'md:text-left md:pl-12'}`}>
              <span class="font-display text-7xl leading-none tracking-tight text-brand-orange md:text-8xl">
                0{i + 1}
              </span>
              <p class="mt-3 text-xs font-medium uppercase tracking-[0.18em] text-brand-orange">
                {tags[i]}
              </p>
              <!-- Dot sulla timeline (desktop) -->
              <div
                class={`absolute top-3 hidden h-3 w-3 rounded-full bg-brand-orange ring-4 ring-brand-ink md:block ${
                  i % 2 === 0 ? 'right-0 translate-x-[calc(100%+2.875rem)]' : 'left-0 -translate-x-[calc(100%+2.875rem)]'
                }`}
              ></div>
            </div>

            <!-- Step content -->
            <div class={`${i % 2 === 0 ? 'md:pl-12' : 'md:pr-12'}`}>
              <h3 class="font-display text-2xl leading-tight md:text-3xl">
                {step.title}
              </h3>
              <p class="mt-4 text-balance leading-relaxed text-brand-paper/70 md:text-lg">
                {step.body}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const line = document.querySelector<HTMLElement>('[data-process-line]');
    const wrapper = line?.parentElement;
    if (line && wrapper) {
      gsap.to(line, {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: wrapper,
          start: 'top 80%',
          end: 'bottom 60%',
          scrub: 0.5,
        },
      });
    }
  }
</script>
