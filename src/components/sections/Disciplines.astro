---
import SectionHeader from '@components/SectionHeader.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [0, 1, 2, 3, 4, 5, 6].map((i) => ({
  title: t(`disciplines.items.${i}.title` as any),
  body: t(`disciplines.items.${i}.body` as any),
}));

// Icone SVG per ogni disciplina
const icons = [
  // Elettrico — fulmine
  '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  // HVAC — vento/aria
  '<path d="M3 8h13a3 3 0 100-6M3 12h17a3 3 0 110 6M3 16h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  // Illuminazione — lampadina
  '<path d="M9 18h6m-5 3h4M12 3a6 6 0 00-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0012 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  // Sicurezza — scudo
  '<path d="M12 3l8 3v5c0 4.5-3.4 8.6-8 10-4.6-1.4-8-5.5-8-10V6l8-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  // Smart Building — casa connessa
  '<path d="M4 11l8-7 8 7v9a2 2 0 01-2 2h-3v-6h-6v6H6a2 2 0 01-2-2v-9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="13" r="1.5" fill="currentColor"/>',
  // Energia & generazione — sole/fotovoltaico
  '<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  // Infrastrutture & ICT — nodi di rete
  '<circle cx="12" cy="5" r="2.2" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="19" r="2.2" stroke="currentColor" stroke-width="1.5"/><circle cx="19" cy="19" r="2.2" stroke="currentColor" stroke-width="1.5"/><path d="M12 7.2v3.3m0 0l-5.4 6.2M12 10.5l5.4 6.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
];
---

<section
  id="discipline"
  class="relative overflow-hidden bg-brand-paper py-section md:py-32"
>
  <div class="container-page">
    <SectionHeader
      eyebrow={t('disciplines.eyebrow')}
      title={t('disciplines.title')}
    />

    <div class="mt-16 grid gap-px overflow-hidden rounded-3xl bg-brand-ink/10 md:mt-24 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item, i) => (
        <article
          class={`reveal group relative flex flex-col bg-brand-paper p-8 transition-colors hover:bg-brand-cream md:p-10 ${
            i === 6 ? 'lg:col-start-2' : ''
          }`}
        >
          <div class="flex items-start justify-between">
            <div class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-orange/10 text-brand-orange transition-all group-hover:scale-110 group-hover:bg-brand-orange group-hover:text-white">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" set:html={icons[i]}></svg>
            </div>
            <span class="font-display text-3xl leading-none text-brand-ink/15">
              0{i + 1}
            </span>
          </div>
          <h3 class="mt-8 font-display text-2xl leading-tight md:text-3xl">
            {item.title}
          </h3>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-brand-ink/70 md:text-base">
            {item.body}
          </p>
          <div class="mt-8 flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-brand-orange opacity-0 transition-opacity group-hover:opacity-100">
            {lang === 'it' ? 'Scopri' : 'Learn more'}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M1 7h12m0 0L7 1m6 6l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
