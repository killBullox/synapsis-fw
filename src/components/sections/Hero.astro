---
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-brand-paper"
  data-hero
>
  <!-- Video di sfondo (placeholder: drop /video/hero.mp4 in /public/video/) -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <video
      class="h-full w-full object-cover opacity-60"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/video/hero-poster.jpg"
      data-hero-video
    >
      <source src="/video/hero.mp4" type="video/mp4" />
      <source src="/video/hero.webm" type="video/webm" />
    </video>
    <!-- Overlay gradient per leggibilità testo -->
    <div class="absolute inset-0 bg-gradient-to-b from-brand-paper/40 via-brand-paper/70 to-brand-paper"></div>
    <!-- Pattern decorativo: linee architettoniche soft -->
    <svg
      class="absolute inset-0 h-full w-full opacity-[0.04]"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse">
          <path d="M 80 0 L 0 0 0 80" fill="none" stroke="currentColor" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <div class="container-page relative flex flex-1 flex-col justify-end pb-16 pt-32 md:pb-24 md:pt-40">
    <!-- Eyebrow -->
    <div class="mb-8 flex items-center gap-3 reveal">
      <span class="h-px w-12 bg-brand-ink/40"></span>
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-brand-ink/60">
        {t('hero.eyebrow')}
      </span>
    </div>

    <!-- Title oversized -->
    <h1 class="max-w-[18ch] font-display text-balance leading-[0.95] tracking-tight" data-hero-title>
      <span class="block text-[clamp(3rem,9vw,9rem)]">
        <span class="reveal-line"><span>{t('hero.titleA')}</span></span>
      </span>
      <span class="block text-[clamp(3rem,9vw,9rem)]">
        <span class="reveal-line"><span>{t('hero.titleB')}</span></span>
      </span>
      <span class="block text-[clamp(3rem,9vw,9rem)] italic text-brand-orange">
        <span class="reveal-line"><span>{t('hero.titleC')}</span></span>
      </span>
    </h1>

    <!-- Subtitle + CTAs -->
    <div class="mt-10 grid gap-8 md:mt-14 md:grid-cols-12 md:items-end">
      <p class="reveal max-w-xl text-balance text-lg leading-relaxed text-brand-ink/70 md:col-span-7 md:text-xl">
        {t('hero.subtitle')}
      </p>
      <div class="reveal flex flex-col gap-3 sm:flex-row md:col-span-5 md:justify-end">
        <a
          href="#contatti"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-ink px-7 py-4 text-sm font-medium text-white transition-all hover:bg-brand-orange"
        >
          {t('hero.cta.primary')}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <button
          type="button"
          class="group inline-flex items-center justify-center gap-2 rounded-full border border-brand-ink/20 bg-white/40 px-7 py-4 text-sm font-medium text-brand-ink backdrop-blur-sm transition-all hover:border-brand-ink/40 hover:bg-white/70"
          data-video-open
        >
          <span class="grid h-6 w-6 place-items-center rounded-full bg-brand-orange text-white transition-transform group-hover:scale-110">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
              <path d="M1 1l8 4-8 4V1z"/>
            </svg>
          </span>
          {t('hero.cta.video')}
        </button>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-16 flex items-center justify-between border-t border-brand-ink/10 pt-6">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-brand-ink/50">
        {t('hero.scroll')}
      </span>
      <div class="flex items-center gap-6 text-xs uppercase tracking-[0.2em] text-brand-ink/50">
        <span class="hidden sm:inline">Milano · Bologna</span>
        <span aria-hidden="true">↓</span>
      </div>
    </div>
  </div>

</section>

<!-- Video modal — fuori dall'hero per evitare problemi di stacking context -->
<div
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-brand-ink/95 backdrop-blur-sm"
  data-video-modal
  role="dialog"
  aria-modal="true"
  aria-label={t('hero.cta.video')}
  style="padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom);"
>
  <button
    type="button"
    class="absolute right-4 top-4 z-10 grid h-12 w-12 place-items-center rounded-full border border-white/20 bg-white/10 text-white backdrop-blur transition-colors hover:bg-white hover:text-brand-ink md:right-8 md:top-8"
    aria-label={t('hero.video.close')}
    data-video-close
  >
    <span class="sr-only">{t('hero.video.close')}</span>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M2 2L14 14M2 14L14 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="relative w-full max-w-6xl px-4 md:px-8">
    <div class="relative aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-2xl">
      <video
        class="h-full w-full"
        controls
        playsinline
        preload="metadata"
        poster="/video/hero-poster.jpg"
        data-modal-video
      >
        <source src="/video/hero.mp4" type="video/mp4" />
        <source src="/video/hero.webm" type="video/webm" />
      </video>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion) {
    document.querySelectorAll<HTMLElement>('[data-hero] .reveal-line > span').forEach((el) => {
      el.style.transform = 'none';
    });
  } else {
    gsap.to('[data-hero] .reveal-line > span', {
      y: '0%',
      duration: 1.1,
      ease: 'expo.out',
      stagger: 0.12,
      delay: 0.2,
    });
  }

  // Pause video se la tab è in background (risparmio batteria mobile)
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else video.play().catch(() => {});
    });
  }

  // Video modal — open / close, autoplay con audio, pause hero video sotto
  const modal = document.querySelector<HTMLElement>('[data-video-modal]');
  const modalVideo = document.querySelector<HTMLVideoElement>('[data-modal-video]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-video-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-video-close]');

  const openModal = () => {
    if (!modal || !modalVideo) return;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    if (video) video.pause();           // pausa il video di sfondo
    modalVideo.currentTime = 0;
    modalVideo.muted = false;            // audio on (l'utente l'ha richiesto cliccando)
    modalVideo.play().catch(() => {
      // Se autoplay con audio è bloccato, almeno mostra il video con i controlli
      modalVideo.muted = true;
      modalVideo.play().catch(() => {});
    });
  };

  const closeModal = () => {
    if (!modal || !modalVideo) return;
    modalVideo.pause();
    modal.style.display = 'none';
    document.body.style.overflow = '';
    if (video) video.play().catch(() => {}); // riprende il video di sfondo
  };

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  // Click su backdrop chiude
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // ESC chiude
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.style.display === 'flex') closeModal();
  });
</script>
