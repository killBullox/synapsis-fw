---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  lastUpdated?: string;
}

const { eyebrow, title, lede, lastUpdated } = Astro.props;
---

<section class="bg-brand-paper pt-32 pb-12 md:pt-40 md:pb-20">
  <div class="container-page">
    <span class="reveal eyebrow bg-brand-orange/12 text-brand-orange">{eyebrow}</span>
    <h1 class="reveal mt-6 max-w-4xl font-display text-balance text-[clamp(2.5rem,6vw,5rem)] leading-[1.05] tracking-tight">
      {title}
    </h1>
    {lede && (
      <p class="reveal mt-6 max-w-2xl text-balance text-lg leading-relaxed text-brand-ink/70 md:text-xl">
        {lede}
      </p>
    )}
    {lastUpdated && (
      <p class="reveal mt-8 text-xs uppercase tracking-[0.18em] text-brand-ink/50">
        {lastUpdated}
      </p>
    )}
  </div>
</section>
