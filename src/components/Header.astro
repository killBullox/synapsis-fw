---
import { getLangFromUrl, useTranslations, localizedPath } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: t('nav.solution'), href: '#soluzione' },
  { label: t('nav.feeWaiver'), href: '#fee-waiver' },
  { label: t('nav.disciplines'), href: '#discipline' },
  { label: t('nav.cases'), href: '#case-study' },
  { label: t('nav.process'), href: '#processo' },
];

const otherLang = lang === 'it' ? 'en' : 'it';
const otherLangPath = localizedPath('/', otherLang);
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-brand-paper/70 backdrop-blur-md transition-[transform,background-color,border-color] duration-300 data-[scrolled=true]:border-brand-ink/10 data-[scrolled=true]:bg-brand-paper/95"
  data-header
  data-scrolled="false"
  style="padding-top: env(safe-area-inset-top);"
>
  <div class="container-page flex items-center justify-between py-4 md:py-5">
    <a
      href={localizedPath('/', lang)}
      class="flex items-center"
      aria-label="Synapsis FW — homepage"
    >
      <img
        src="/logo.svg"
        alt="Synapsis FW"
        width="220"
        height="132"
        class="h-12 w-auto md:h-14 lg:h-16"
      />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-brand-ink/70 transition-colors hover:text-brand-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={otherLangPath}
        class="hidden text-sm font-medium text-brand-ink/70 transition-colors hover:text-brand-ink md:inline"
        aria-label={`Switch to ${otherLang.toUpperCase()}`}
      >
        {otherLang.toUpperCase()}
      </a>
      <a
        href="#contatti"
        class="hidden rounded-full bg-brand-ink px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-brand-orange md:inline-block"
      >
        {t('nav.cta')}
      </a>
      <button
        type="button"
        class="grid h-11 w-11 place-items-center rounded-full border border-brand-ink/15 bg-white/60 backdrop-blur lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none">
          <path d="M0 1H18M0 7H18M0 13H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu — FUORI dall'header per evitare bug iOS Safari (parent con transform spezza fixed) -->
<div
  class="fixed inset-0 z-[70] hidden flex-col lg:hidden"
  data-mobile-menu
  style="background-color: #f7efe1; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom);"
>
  <!-- Top bar interna del menu: logo + close -->
  <div class="container-page flex items-center justify-between py-4 md:py-5">
    <a
      href={localizedPath('/', lang)}
      class="flex items-center"
      aria-label="Synapsis FW — homepage"
      data-menu-link
    >
      <img
        src="/logo.svg"
        alt="Synapsis FW"
        width="220"
        height="132"
        class="h-12 w-auto md:h-14"
      />
    </a>
    <button
      type="button"
      class="grid h-11 w-11 place-items-center rounded-full border border-brand-ink/15 bg-white/80 text-brand-ink"
      aria-label="Close menu"
      data-menu-toggle
    >
      <span class="sr-only">Chiudi</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="container-page flex flex-1 flex-col justify-between pb-8">
    <nav class="flex flex-col gap-5 pt-8" aria-label="Mobile">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-display text-4xl tracking-tight text-brand-ink"
          data-menu-link
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="mt-8 flex items-center justify-between border-t border-brand-ink/10 pt-6">
      <a
        href={otherLangPath}
        class="text-sm font-medium uppercase tracking-widest text-brand-ink/70"
      >
        {otherLang}
      </a>
      <a
        href="#contatti"
        class="rounded-full bg-brand-ink px-6 py-3 text-sm font-medium text-white"
        data-menu-link
      >
        {t('nav.cta')}
      </a>
    </div>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

  // Hide on scroll down, show on scroll up + scrolled state for bg opacity
  let lastY = 0;
  window.addEventListener('scroll', () => {
    if (!header) return;
    const y = window.scrollY;
    if (y > 80 && y > lastY) header.style.transform = 'translateY(-110%)';
    else header.style.transform = 'translateY(0)';
    header.dataset.scrolled = String(y > 24);
    lastY = y;
  }, { passive: true });

  // Mobile menu toggle (entrambi i bottoni: hamburger fuori + X dentro)
  let open = false;
  const setOpen = (next: boolean) => {
    open = next;
    if (!menu) return;
    toggles.forEach((t) => t.setAttribute('aria-expanded', String(next)));
    menu.style.display = next ? 'flex' : 'none';
    document.body.style.overflow = next ? 'hidden' : '';
  };
  toggles.forEach((t) => t.addEventListener('click', () => setOpen(!open)));
  menuLinks.forEach((link) => link.addEventListener('click', () => setOpen(false)));

  // ESC chiude il menu
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });
</script>
