---
import AppLayout from '@layouts/AppLayout.astro';
---

<AppLayout
  title="Calcolatore MEP — Area Riservata · Synapsis FW"
  description="Stima parametrica del valore impianti MEP e della parcella SFW."
  active="calcolatore"
>
  <div class="wrap">
    <div class="header">
      <div class="brand">SFW — Synapsis FW</div>
      <h1>Stima valore impianti MEP</h1>
      <div class="subtitle">Parametrico di mercato Italia 2026 — uso interno</div>
    </div>

    <!-- Project bar -->
    <div class="proj-bar">
      <div class="proj-left">
        <span class="proj-label">Progetto</span>
        <select id="proj-select"></select>
        <span class="proj-dirty" id="proj-dirty" style="display:none;" title="Modifiche non salvate">•</span>
      </div>
      <div class="proj-right">
        <button type="button" class="btn" id="btn-proj-new">Nuovo</button>
        <button type="button" class="btn p" id="btn-proj-save">Salva</button>
        <button type="button" class="btn" id="btn-proj-saveas">Salva con nome</button>
        <button type="button" class="btn d" id="btn-proj-delete" style="display:none;">Elimina</button>
        <span style="flex:1;"></span>
        <button type="button" class="btn proj-mini" id="btn-proj-export" title="Scarica tutti i progetti come JSON">Export</button>
        <button type="button" class="btn proj-mini" id="btn-proj-import" title="Carica progetti da file JSON">Import</button>
        <input type="file" id="proj-file" accept="application/json,.json" style="display:none;" />
      </div>
    </div>

    <div class="tabs">
      <div class="tab active" onclick="switchTab('calc')">Calcolo</div>
      <div class="tab" onclick="switchTab('config')">Parametri</div>
      <div class="tab" onclick="switchTab('contract')">Contratto</div>
      <div class="tab" onclick="switchTab('margin')">Margini SFW</div>
    </div>

    <div id="tab-calc" class="panel active">
      <div class="g2">
        <div class="field"><span class="fl">Destinazione d'uso</span><select id="tipo" onchange="calc()"></select></div>
        <div class="field"><span class="fl">Superficie lorda (mq)</span><input type="number" id="mq" value="1000" min="50" max="500000" step="50" oninput="calc()"/></div>
      </div>
      <div style="margin-bottom:8px;"><span class="fl">Discipline incluse</span></div>
      <div class="dg" id="dg"></div>

      <div style="margin-bottom:8px;"><span class="fl">Servizi opzionali</span></div>
      <div class="sg" id="sg"></div>

      <div style="margin-bottom:8px;"><span class="fl">Complessità progetto</span></div>
      <div class="cxr"><input type="range" id="cx" min="0" max="100" value="50" step="1" oninput="calc()" style="flex:1;"/><span class="cxv" id="cxl">Media</span></div>
      <div class="cxl"><span>Standard</span><span>Molto elevata</span></div>
      <div class="div"></div>
      <div id="res"></div>
    </div>

    <!-- TAB CONTRATTO -->
    <div id="tab-contract" class="panel">
      <p style="font-size:13px;color:#666;margin-bottom:1rem;">
        Compila i dati mancanti e genera il contratto pre-compilato. I parametri tecnici (superficie, discipline, parcella) sono importati dal tab Calcolo.
      </p>

      <div class="ct-section">
        <div class="ct-st">Progetto</div>
        <div class="g2">
          <div class="field"><span class="fl">Denominazione</span><input type="text" id="c-proj-name" placeholder="es. Residenza Le Magnolie"/></div>
          <div class="field"><span class="fl">Indirizzo cantiere</span><input type="text" id="c-proj-address" placeholder="Via, Città"/></div>
        </div>
        <div class="g2">
          <div class="field">
            <span class="fl">Fase di progettazione</span>
            <select id="c-proj-phase">
              <option>Preliminare</option>
              <option selected>Definitivo</option>
              <option>Esecutivo</option>
              <option>Capitolato</option>
              <option>DL Forniture</option>
            </select>
          </div>
          <div class="field"><span class="fl">Termine consegna (gg lavorativi)</span><input type="number" id="c-delivery-days" value="60" min="1" step="1"/></div>
        </div>
        <div class="field"><span class="fl">Cronoprogramma cantiere (riferimento)</span><input type="text" id="c-crono" placeholder="es. avvio 03/2026 — completamento 12/2026"/></div>
      </div>

      <div class="ct-section">
        <div class="ct-st">Economia — parcella e servizi (editabili)</div>
        <p style="font-size:12px;color:#888;margin-bottom:0.75rem;">
          Valori pre-compilati dal calcolo. Puoi modificarli prima di generare il contratto. Il box scenari sotto si aggiorna in tempo reale.
        </p>
        <div class="g2">
          <div class="field">
            <span class="fl">Parcella progettazione (€)</span>
            <input type="number" id="c-fee" value="0" min="0" step="100" />
          </div>
          <div class="field">
            <span class="fl">IVA %</span>
            <input type="number" id="c-vat" value="22" min="0" max="100" step="1"/>
          </div>
        </div>

        <!-- Servizi aggiuntivi editabili — popolati dinamicamente -->
        <div id="c-srv-wrap" style="margin-top:0.5rem;"></div>

        <div class="g2" style="margin-top:0.75rem;">
          <div class="field">
            <span class="fl">Scenario Fee Waiver atteso</span>
            <select id="c-scenario">
              <option value="1" selected>Scenario 1 — supply SFW</option>
              <option value="2">Scenario 2 — brand conformi</option>
              <option value="3">Scenario 3 — terzi non conformi</option>
            </select>
          </div>
          <div class="field">
            <span class="fl">Foro competente</span>
            <input type="text" id="c-foro" value="Napoli" placeholder="es. Napoli"/>
          </div>
        </div>

        <!-- Box scenari riepilogativo (live) -->
        <div id="c-scenarios" style="margin-top:1rem;"></div>
      </div>

      <div class="ct-section">
        <div class="ct-st">Cliente</div>
        <div class="g2">
          <div class="field"><span class="fl">Ragione sociale</span><input type="text" id="c-cli-name" placeholder=""/></div>
          <div class="field"><span class="fl">Forma giuridica</span><input type="text" id="c-cli-form" placeholder="S.r.l. / S.p.A. / Privato / ..."/></div>
        </div>
        <div class="g2">
          <div class="field"><span class="fl">Sede legale</span><input type="text" id="c-cli-seat"/></div>
          <div class="field"><span class="fl">P.IVA / C.F.</span><input type="text" id="c-cli-vat"/></div>
        </div>
        <div class="g2">
          <div class="field"><span class="fl">Legale Rapp.te</span><input type="text" id="c-cli-legal"/></div>
          <div class="field"><span class="fl">PEC</span><input type="email" id="c-cli-pec"/></div>
        </div>
        <div class="g2">
          <div class="field"><span class="fl">Telefono</span><input type="tel" id="c-cli-phone"/></div>
          <div class="field"><span class="fl">Luogo di stipula</span><input type="text" id="c-sign-place" placeholder="Napoli"/></div>
        </div>
      </div>

      <div class="ct-section">
        <div class="ct-st">Synapsis FW S.r.l. — dati professionista <span style="font-weight:400;color:#888;font-size:11px;">(salvati e riutilizzati)</span></div>
        <div class="g2">
          <div class="field"><span class="fl">Sede</span><input type="text" id="c-sfw-seat" placeholder="Indirizzo completo"/></div>
          <div class="field"><span class="fl">P.IVA</span><input type="text" id="c-sfw-vat"/></div>
        </div>
        <div class="field"><span class="fl">Legale Rappresentante</span><input type="text" id="c-sfw-legal"/></div>
      </div>

      <div style="display:flex;gap:8px;margin-top:1.5rem;flex-wrap:wrap;align-items:center;">
        <button type="button" class="btn p" id="btn-generate-contract">Genera contratto →</button>
        <button type="button" class="btn" id="btn-save-sfw-data">Salva dati SFW</button>
        <span style="font-size:12px;color:#888;">Si aprirà in una nuova scheda, pronto per la stampa o l'esportazione PDF.</span>
      </div>
    </div>

    <!-- TAB MARGINI SFW -->
    <div id="tab-margin" class="panel">
      <p style="font-size:13px;color:#666;margin-bottom:1rem;">
        Vista interna SFW: margine netto per scenario. Include il margine sui servizi opzionali (con markup), non intaccato dal Fee Waiver né dal cashback.
      </p>

      <!-- Box riepilogo: parcella + servizi -->
      <div class="mr" style="margin-bottom:1rem;">
        <div class="mt">
          <div class="ml">Valore parcella</div>
          <div class="mv" id="m-fee-val">€ —</div>
          <div class="ms" id="m-fee-pct-info"></div>
        </div>
        <div class="mt">
          <div class="ml">Valore altri servizi</div>
          <div class="mv" id="m-srv-val">€ —</div>
          <div class="ms" id="m-srv-info"></div>
        </div>
      </div>

      <div class="ct-section">
        <div class="ct-st">Parametri SFW</div>
        <div class="g2">
          <div class="field">
            <span class="fl">Costo parcelle (% del MEP)</span>
            <input type="number" id="m-cost-pct" min="0" max="50" step="0.1" />
          </div>
          <div class="field">
            <span class="fl">% parcella verso cliente (riferimento)</span>
            <input type="text" id="m-fee-pct-ref" disabled style="background:#f5f5f5;" />
          </div>
        </div>
        <div class="g2" style="margin-top:0.75rem;">
          <div class="field">
            <span class="fl">Markup servizi opzionali (%)</span>
            <input type="number" id="m-srv-markup" min="0" max="100" step="0.5" />
          </div>
          <div class="field">
            <span class="fl">Project Incentive — PI (% del MEP)</span>
            <input type="number" id="m-pi-pct" min="0" max="100" step="0.5" />
          </div>
        </div>
        <p style="font-size:11px;color:#888;margin-top:0.5rem;">
          Costo parcelle default: parcella verso cliente − 1 punto. Markup servizi default: 15%. Project Incentive default: 15% del valore MEP — riconosciuto solo negli Scenari 1 e 2.
        </p>
        <div style="display:flex;gap:8px;margin-top:0.5rem;flex-wrap:wrap;">
          <button type="button" class="btn p" id="btn-save-markup">Salva parametri</button>
          <button type="button" class="btn" id="btn-margin-default">Reimposta default</button>
        </div>
      </div>

      <!-- Box margini per scenario (live) -->
      <div id="m-scenarios" style="margin-top:1rem;"></div>
    </div>

    <div id="tab-config" class="panel">
      <div class="ct">
        <select id="cts" onchange="renderPT()" style="flex:1;"></select>
        <button class="btn" onclick="toggleNF()">+ Nuova</button>
        <button class="btn d" id="bdel" onclick="delTipo()" style="display:none;">Elimina</button>
      </div>
      <div class="rename-row">
        <div class="field" style="flex:1;">
          <span class="fl">Nome destinazione</span>
          <input type="text" id="rename-input" />
        </div>
        <button class="btn" onclick="renameTipo()">Rinomina</button>
      </div>
      <div id="pw"></div>
      <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
        <button class="btn p" onclick="saveP()">Salva come default</button>
        <button class="btn" onclick="resetP()">Ripristina originali</button>
      </div>
      <!-- Sezione Bonus / Cashback Fee Waiver -->
      <div class="srv-section">
        <div class="srv-title">Bonus & Cashback — % sulla parcella</div>
        <div class="g2">
          <div class="field">
            <span class="fl">Bonus cliente Sc. 1 (%)</span>
            <input type="number" id="fw-bonus" min="0" max="100" step="0.5" />
          </div>
          <div class="field">
            <span class="fl">Cashback Sc. 3 (%)</span>
            <input type="number" id="fw-cashback" min="0" max="100" step="0.5" />
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
          <button type="button" class="btn p" id="btn-save-fw">Salva bonus & cashback</button>
          <button type="button" class="btn" id="btn-reset-fw">Ripristina default</button>
        </div>
      </div>

      <!-- Sezione servizi opzionali -->
      <div class="srv-section">
        <div class="srv-title">Servizi opzionali — % sul MEP</div>
        <div id="srv-table-wrap"></div>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
          <button type="button" class="btn p" id="btn-save-srv">Salva servizi</button>
          <button type="button" class="btn" id="btn-reset-srv">Ripristina servizi</button>
        </div>
      </div>

      <div id="nf" style="display:none;" class="nf">
        <div class="nft">Nuova destinazione d'uso</div>
        <div class="fr"><label>Nome</label><input type="text" id="nl" placeholder="es. Data Center" style="flex:1;"/></div>
        <div style="font-size:12px;color:#666;margin-bottom:10px;">Parametri €/mq per disciplina (min – max)</div>
        <div id="npg"></div>
        <div style="display:flex;gap:8px;margin-top:12px;">
          <button class="btn p" onclick="addNew()">Aggiungi</button>
          <button class="btn" onclick="toggleNF()">Annulla</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</AppLayout>

<style is:global>
  /* === Stili calcolatore — copia fedele dell'HTML originale === */
  .wrap { max-width: 860px; margin: 0 auto; }

  .wrap .proj-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    padding: 12px 14px; background: #fafafa; border: 1px solid #e0e0e0;
    border-radius: 8px; margin-bottom: 1rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .wrap .proj-left { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 240px; }
  .wrap .proj-right { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .wrap .proj-label { font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: .06em; }
  .wrap #proj-select {
    height: 32px; padding: 0 10px; border: 1px solid #d0d0d0; border-radius: 6px;
    background: #fff; color: #1E1E1E; font-size: 13px; min-width: 200px; flex: 1;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .wrap #proj-select:focus { outline: none; border-color: #E8580A; }
  .wrap .proj-dirty { color: #E8580A; font-weight: 700; font-size: 18px; line-height: 1; }
  .wrap .proj-bar .btn { height: 32px; padding: 0 12px; font-size: 12px; }
  .wrap .btn.proj-mini { font-size: 11px; color: #888; padding: 0 10px; }
  .wrap .header { padding: 0 0 1.25rem; border-bottom: 1px solid #e0e0e0; margin-bottom: 1.5rem; }
  .wrap .brand { font-size: 11px; font-weight: 600; letter-spacing: .1em; color: #E8580A; text-transform: uppercase; }
  .wrap h1 { font-family: system-ui, -apple-system, sans-serif; font-size: 22px; font-weight: 500; color: #1E1E1E; margin-top: 4px; line-height: 1.3; letter-spacing: 0; }
  .wrap .subtitle { font-size: 13px; color: #666; margin-top: 3px; }

  .wrap .tabs { display: flex; border-bottom: 1px solid #e0e0e0; margin-bottom: 0; background: #fff; border-radius: 8px 8px 0 0; overflow: hidden; }
  .wrap .tab { padding: 12px 20px; font-size: 13px; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; color: #666; background: #fff; font-family: system-ui, -apple-system, sans-serif; }
  .wrap .tab:hover { color: #1E1E1E; }
  .wrap .tab.active { color: #E8580A; border-bottom-color: #E8580A; background: #fff; }

  .wrap .panel { display: none; background: #fff; border-radius: 0 0 8px 8px; padding: 1.5rem; border: 1px solid #e0e0e0; border-top: none; font-family: system-ui, -apple-system, sans-serif; color: #1E1E1E; }
  .wrap .panel.active { display: block; }

  .wrap .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.25rem; }
  .wrap .field { display: flex; flex-direction: column; gap: 6px; }
  .wrap .fl { font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: .06em; }

  .wrap select, .wrap input[type=number], .wrap input[type=text] {
    height: 40px; padding: 0 12px; border: 1px solid #d0d0d0; border-radius: 8px;
    background: #fff; color: #1E1E1E; font-size: 14px; width: 100%;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .wrap select:focus, .wrap input:focus { outline: none; border-color: #E8580A; }

  .wrap .dg { display: grid; grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); gap: 8px; margin-bottom: 1.5rem; }
  .wrap .dc { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid #e0e0e0; border-radius: 8px; cursor: pointer; background: #fff; transition: border-color .15s; }
  .wrap .dc:hover { border-color: #ccc; }
  .wrap .dc.on { border-color: #E8580A; background: #fff8f5; }
  .wrap .dc.on .dot { background: #E8580A; }
  .wrap .dot { width: 8px; height: 8px; border-radius: 50%; background: #ccc; flex-shrink: 0; }
  .wrap .dn { font-size: 13px; font-weight: 500; }
  .wrap .dr { font-size: 11px; color: #888; margin-top: 1px; }

  .wrap .cxr { display: flex; align-items: center; gap: 12px; margin-bottom: .5rem; }
  .wrap .cxv { font-size: 13px; font-weight: 600; min-width: 90px; text-align: right; color: #E8580A; }
  .wrap .cxl { display: flex; justify-content: space-between; font-size: 11px; color: #888; margin-bottom: 1.5rem; }
  .wrap input[type=range] { width: 100%; accent-color: #E8580A; }

  .wrap .div { height: 1px; background: #e0e0e0; margin: 1.5rem 0; }
  .wrap .sl { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #666; margin-bottom: 12px; }

  .wrap .mr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 1rem; }
  .wrap .mt { background: #f5f5f5; border-radius: 8px; padding: 14px 16px; }
  .wrap .mt.hi { background: #fff0e6; }
  .wrap .ml { font-size: 12px; color: #666; margin-bottom: 6px; }
  .wrap .mv { font-size: 20px; font-weight: 500; color: #1E1E1E; }
  .wrap .mt.hi .mv { color: #E8580A; }
  .wrap .ms { font-size: 11px; color: #888; margin-top: 3px; }

  .wrap .bh { display: grid; grid-template-columns: 1fr 88px 88px 88px; gap: 8px; padding: 6px 12px; font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: .05em; }
  .wrap .br { display: grid; grid-template-columns: 1fr 88px 88px 88px; gap: 8px; padding: 9px 12px; border-radius: 6px; font-size: 13px; align-items: center; }
  .wrap .br:hover { background: #f5f5f5; }
  .wrap .bt { display: grid; grid-template-columns: 1fr 88px 88px 88px; gap: 8px; padding: 10px 12px; margin-top: 4px; border-top: 1px solid #ccc; font-size: 13px; font-weight: 600; }
  .wrap .nr { text-align: right; font-variant-numeric: tabular-nums; }
  .wrap .nm { text-align: right; font-variant-numeric: tabular-nums; color: #888; }

  .wrap .fw { margin-top: 1.25rem; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; }
  .wrap .fwr { display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; align-items: center; padding: 12px 16px; border-bottom: 1px solid #e0e0e0; background: #fff; }
  .wrap .fwr:last-child { border-bottom: none; }
  .wrap .fws { font-size: 11px; font-weight: 600; color: #888; }
  .wrap .fvr { font-size: 13px; font-weight: 600; text-align: right; white-space: nowrap; }
  .wrap .fvr.z { color: #2E7D32; }
  .wrap .fvr.f { color: #E8580A; }

  .wrap .ct { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .wrap .btn { height: 36px; padding: 0 16px; border: 1px solid #d0d0d0; border-radius: 8px; background: #fff; color: #1E1E1E; font-size: 13px; cursor: pointer; white-space: nowrap; font-family: system-ui, -apple-system, sans-serif; font-weight: 500; }
  .wrap .btn:hover { background: #f5f5f5; }
  .wrap .btn.p { background: #E8580A; color: #fff; border-color: #E8580A; }
  .wrap .btn.p:hover { background: #c94800; }
  .wrap .btn.d { color: #c0392b; border-color: #c0392b; }
  .wrap .btn.d:hover { background: #fff5f5; }

  .wrap .rename-row { display: flex; align-items: end; gap: 8px; margin-bottom: 1rem; padding: 12px; background: #fafafa; border: 1px solid #e0e0e0; border-radius: 8px; }

  .wrap .pt { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 1rem; }
  .wrap .pt th { text-align: left; padding: 8px 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: #666; border-bottom: 1px solid #e0e0e0; }
  .wrap .pt td { padding: 6px 8px; border-bottom: 1px solid #e0e0e0; }
  .wrap .pt tr:last-child td { border-bottom: none; }
  .wrap .pt td:first-child { font-weight: 500; padding-left: 10px; }
  .wrap .pi { height: 32px; padding: 0 8px; border: 1px solid #d0d0d0; border-radius: 6px; background: #fff; color: #1E1E1E; font-size: 13px; width: 80px; text-align: right; font-family: system-ui, -apple-system, sans-serif; }
  .wrap .pi:focus { outline: none; border-color: #E8580A; }

  .wrap .nf { border: 1px solid #e0e0e0; border-radius: 8px; padding: 1rem; margin-top: 1rem; background: #f8f8f8; }
  .wrap .nft { font-size: 13px; font-weight: 600; margin-bottom: 12px; }
  .wrap .fr { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .wrap .fr label { font-size: 12px; color: #666; min-width: 160px; }

  .wrap .empty { text-align: center; padding: 2rem; color: #888; font-size: 14px; }

  /* Servizi opzionali — card stile discipline */
  .wrap .sg { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; margin-bottom: 1.5rem; }
  .wrap .sc { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border: 1px solid #e0e0e0; border-radius: 8px; cursor: pointer; background: #fff; transition: border-color .15s; }
  .wrap .sc:hover { border-color: #ccc; }
  .wrap .sc.on { border-color: #E8580A; background: #fff8f5; }
  .wrap .sc.on .sdot { background: #E8580A; }
  .wrap .sdot { width: 8px; height: 8px; border-radius: 50%; background: #ccc; flex-shrink: 0; margin-top: 5px; }
  .wrap .sn { font-size: 13px; font-weight: 500; }
  .wrap .sr { font-size: 11px; color: #888; margin-top: 2px; }
  .wrap .sv { font-size: 12px; color: #E8580A; font-weight: 600; margin-top: 4px; font-variant-numeric: tabular-nums; }

  /* Breakdown servizi nei risultati */
  .wrap .sbh, .wrap .sbr, .wrap .sbt {
    display: grid; grid-template-columns: 1fr 110px 110px; gap: 8px; font-size: 13px; align-items: center;
  }
  .wrap .sbh { padding: 6px 12px; font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: .05em; }
  .wrap .sbr { padding: 9px 12px; border-radius: 6px; }
  .wrap .sbr:hover { background: #f5f5f5; }
  .wrap .sbt { padding: 10px 12px; margin-top: 4px; border-top: 1px solid #ccc; font-size: 13px; font-weight: 600; }

  /* Box totale complessivo (vecchio, ora non più usato) */
  .wrap .tot-box {
    margin-top: 1.25rem; padding: 16px 18px; background: #1E1E1E; color: #fff; border-radius: 8px;
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
  }
  .wrap .tot-box .tot-l { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; opacity: .7; }
  .wrap .tot-box .tot-v { font-size: 22px; font-weight: 600; color: #E8580A; font-variant-numeric: tabular-nums; }

  /* Box scenario — totale evidenziato + dettaglio */
  .wrap .sc-box {
    margin-top: 12px;
    padding: 18px 22px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-left: 4px solid #888;
    border-radius: 8px;
  }
  .wrap .sc-box--win {
    background: #f5fbf5;
    border-left-color: #2E7D32;
  }
  .wrap .sc-box--alt {
    background: #fff8f5;
    border-left-color: #E8580A;
  }
  .wrap .sc-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .wrap .sc-tag {
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    background: #888;
    text-transform: uppercase;
    letter-spacing: .08em;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .wrap .sc-box--win .sc-tag { background: #2E7D32; }
  .wrap .sc-box--alt .sc-tag { background: #E8580A; }
  .wrap .sc-desc {
    font-size: 13px;
    color: #444;
    font-weight: 500;
  }
  .wrap .sc-tot {
    font-size: 32px;
    font-weight: 700;
    color: #1E1E1E;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 4px 0 6px;
  }
  .wrap .sc-box--win .sc-tot { color: #2E7D32; }
  .wrap .sc-box--alt .sc-tot { color: #E8580A; }
  .wrap .sc-detail {
    font-size: 13px;
    color: #666;
    font-variant-numeric: tabular-nums;
  }
  .wrap .sc-bonus {
    color: #E8580A;
    font-weight: 600;
    margin-left: 6px;
    display: inline-block;
  }

  /* Tab Contratto */
  .wrap .ct-section { margin-bottom: 1.5rem; padding: 1rem 1.25rem; border: 1px solid #e0e0e0; border-radius: 8px; background: #fafafa; }
  .wrap .ct-st { font-size: 11px; font-weight: 600; color: #1E1E1E; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid #e0e0e0; }
  .wrap .ct-section .g2 { margin-bottom: 0.75rem; }
  .wrap .ct-section .g2:last-child { margin-bottom: 0; }
  .wrap .ct-section .field { margin-bottom: 0.5rem; }

  /* Parametri tab — sezione servizi */
  .wrap .srv-section { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #e0e0e0; }
  .wrap .srv-title { font-size: 12px; font-weight: 600; color: #1E1E1E; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; }
  .wrap .stl { width: 100%; border-collapse: collapse; font-size: 13px; }
  .wrap .stl th { text-align: left; padding: 8px 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: #666; border-bottom: 1px solid #e0e0e0; }
  .wrap .stl td { padding: 6px 8px; border-bottom: 1px solid #e0e0e0; }
  .wrap .stl tr:last-child td { border-bottom: none; }
  .wrap .stl td:first-child { font-weight: 500; padding-left: 10px; min-width: 200px; }
  .wrap .sin {
    height: 32px; padding: 0 8px; border: 1px solid #d0d0d0; border-radius: 6px;
    background: #fff; color: #1E1E1E; font-size: 13px; width: 80px; text-align: right;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .wrap .sin:focus { outline: none; border-color: #E8580A; }
  .wrap .stl .lbl-input {
    height: 32px; padding: 0 8px; border: 1px solid #d0d0d0; border-radius: 6px;
    background: #fff; color: #1E1E1E; font-size: 13px; width: 100%;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .wrap .stl .lbl-input:focus { outline: none; border-color: #E8580A; }

  .toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #1E1E1E; color: #fff; padding: 10px 18px; border-radius: 8px; font-size: 13px; opacity: 0; transition: opacity .3s; pointer-events: none; z-index: 999; }
  .toast.show { opacity: 1; }

  @media (max-width: 560px) {
    .wrap .g2 { grid-template-columns: 1fr; }
    .wrap .mr { grid-template-columns: 1fr 1fr; }
  }
</style>

<script is:inline>
  const DD = [
    {id:"elettrico",label:"Impianti elettrici"},
    {id:"hvac",label:"HVAC & clima"},
    {id:"illuminazione",label:"Illuminazione"},
    {id:"sicurezza",label:"Sicurezza & accessi"},
    {id:"smart",label:"Smart building"},
    {id:"energia",label:"Energia & generazione"},
    {id:"infra",label:"Infrastrutture & ICT"},
  ];
  const DEF = {
    res_prem:{label:"Residenziale premium",custom:false,elettrico:[35,55],hvac:[80,130],illuminazione:[20,40],sicurezza:[15,25],smart:[25,50],energia:[20,35],infra:[10,15]},
    res_std:{label:"Residenziale standard",custom:false,elettrico:[22,38],hvac:[55,95],illuminazione:[10,20],sicurezza:[8,15],smart:[8,20],energia:[12,25],infra:[7,12]},
    dir:{label:"Direzionale / Uffici",custom:false,elettrico:[45,70],hvac:[90,150],illuminazione:[25,50],sicurezza:[20,35],smart:[30,60],energia:[25,45],infra:[15,25]},
    hos:{label:"Hospitality",custom:false,elettrico:[55,85],hvac:[100,170],illuminazione:[40,80],sicurezza:[25,45],smart:[35,70],energia:[30,55],infra:[15,25]},
    stu:{label:"Studentati / PBSA",custom:false,elettrico:[30,50],hvac:[65,110],illuminazione:[15,30],sicurezza:[20,35],smart:[20,40],energia:[20,40],infra:[12,20]},
    hea:{label:"Healthcare / Cliniche",custom:false,elettrico:[80,130],hvac:[130,220],illuminazione:[35,60],sicurezza:[40,70],smart:[40,75],energia:[35,65],infra:[20,35]},
    ind:{label:"Industriale / Logistica",custom:false,elettrico:[30,50],hvac:[40,80],illuminazione:[15,30],sicurezza:[15,30],smart:[10,25],energia:[20,40],infra:[8,15]},
    ret:{label:"Retail / Commerciale",custom:false,elettrico:[40,65],hvac:[85,140],illuminazione:[35,70],sicurezza:[20,40],smart:[20,45],energia:[25,45],infra:[12,20]},
    spo:{label:"Sport & Wellness",custom:false,elettrico:[40,65],hvac:[90,160],illuminazione:[25,50],sicurezza:[15,30],smart:[20,40],energia:[30,60],infra:[10,18]},
    pub:{label:"Pubblico / Istituzionale",custom:false,elettrico:[35,55],hvac:[70,120],illuminazione:[20,40],sicurezza:[20,38],smart:[20,45],energia:[20,40],infra:[12,22]},
    dat:{label:"Data Center / Server Room",custom:false,elettrico:[200,400],hvac:[300,600],illuminazione:[15,25],sicurezza:[60,110],smart:[50,100],energia:[150,350],infra:[80,160]},
    mix:{label:"Misto residenziale-commerciale",custom:false,elettrico:[38,60],hvac:[75,130],illuminazione:[28,55],sicurezza:[18,32],smart:[22,48],energia:[22,40],infra:[12,22]},
  };
  const PARC = [0.04, 0.07];

  // Bonus / Cashback default — applicati alla parcella, modificabili nei parametri
  const FW_DEF = { bonus_pct: 0.10, cashback_pct: 0.15 };
  let FW = JSON.parse(JSON.stringify(FW_DEF));

  // Markup SFW sui servizi opzionali (margine per SFW sui servizi, non intaccato da FW)
  const SRV_MARKUP_DEF = 0.15; // 15%
  let srvMarkup = SRV_MARKUP_DEF;

  // Project Incentive — % sul valore materiali (MEP), riconosciuto solo Sc.1 e Sc.2
  const PI_PCT_DEF = 0.15; // 15%
  let piPct = PI_PCT_DEF;

  // Servizi opzionali — % sul valore MEP, riferimenti media nazionale Italia 2026
  const SRV_DEF = {
    dl:  { label: 'Direzione Lavori impianti',                  pct: [0.020, 0.040] }, // 2-4%
    csp: { label: 'Coord. Sicurezza Progettazione (CSP)',       pct: [0.005, 0.015] }, // 0.5-1.5%
    cse: { label: 'Coord. Sicurezza Esecuzione (CSE)',          pct: [0.010, 0.020] }, // 1-2%
    col: { label: 'Collaudi e messa in servizio',               pct: [0.005, 0.020] }, // 0.5-2%
    ass: { label: 'Assistenza gara d\'appalto',                  pct: [0.005, 0.015] }, // 0.5-1.5%
  };

  let P = JSON.parse(JSON.stringify(DEF));
  let SRV = JSON.parse(JSON.stringify(SRV_DEF));
  let act = new Set(DD.map(d => d.id));
  let actS = new Set();   // servizi attivi (di default nessuno)
  let snf = false;

  function loadS(){
    try{const s=localStorage.getItem('sfw-mep-v4');if(s){const d=JSON.parse(s);Object.keys(d).forEach(k=>{P[k]=d[k];});}}catch(e){}
    try{const s2=localStorage.getItem('sfw-srv-v1');if(s2){const d=JSON.parse(s2);Object.keys(d).forEach(k=>{if(SRV[k])SRV[k]={...SRV[k],...d[k]};});}}catch(e){}
    try{const s3=localStorage.getItem('sfw-fw-v1');if(s3){const d=JSON.parse(s3);FW={...FW,...d};}}catch(e){}
    try{const s4=localStorage.getItem('sfw-srv-markup-v1');if(s4){srvMarkup=parseFloat(s4)||SRV_MARKUP_DEF;}}catch(e){}
    try{const s5=localStorage.getItem('sfw-pi-pct-v1');if(s5){piPct=parseFloat(s5)||PI_PCT_DEF;}}catch(e){}
  }
  function saveS(){try{localStorage.setItem('sfw-mep-v4',JSON.stringify(P));}catch(e){}}
  function saveSrv(){try{localStorage.setItem('sfw-srv-v1',JSON.stringify(SRV));}catch(e){}}
  function saveFw(){try{localStorage.setItem('sfw-fw-v1',JSON.stringify(FW));}catch(e){}}
  function saveMarkup(){try{localStorage.setItem('sfw-srv-markup-v1',String(srvMarkup));}catch(e){}}
  function savePi(){try{localStorage.setItem('sfw-pi-pct-v1',String(piPct));}catch(e){}}
  function toast(m){const t=document.getElementById("toast");t.textContent=m;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2200);}

  function bSel(id,sel){const el=document.getElementById(id);const prev=sel||el.value;el.innerHTML="";Object.keys(P).forEach(k=>{const o=document.createElement("option");o.value=k;o.textContent=P[k].label+(P[k].custom?"  •":"");if(k===prev)o.selected=true;el.appendChild(o);});}

  function bDG(){const g=document.getElementById("dg");g.innerHTML="";DD.forEach(d=>{const c=document.createElement("div");c.className="dc"+(act.has(d.id)?" on":"");c.innerHTML=`<div class="dot"></div><div><div class="dn">${d.label}</div><div class="dr" id="r-${d.id}"></div></div>`;c.onclick=()=>{if(act.has(d.id)){if(act.size>1)act.delete(d.id);}else act.add(d.id);bDG();calc();};g.appendChild(c);});uR();}

  function bSG(){
    const g = document.getElementById("sg");
    if (!g) return;
    g.innerHTML = "";
    Object.keys(SRV).forEach(k => {
      const s = SRV[k];
      const c = document.createElement("div");
      c.className = "sc" + (actS.has(k) ? " on" : "");
      c.innerHTML = `
        <div class="sdot"></div>
        <div style="flex:1;">
          <div class="sn">${s.label}</div>
          <div class="sr" id="sr-${k}">${(s.pct[0]*100).toFixed(1)}% – ${(s.pct[1]*100).toFixed(1)}% del MEP</div>
          <div class="sv" id="sv-${k}"></div>
        </div>`;
      c.onclick = () => {
        if (actS.has(k)) actS.delete(k); else actS.add(k);
        bSG();
        calc();
      };
      g.appendChild(c);
    });
    uSrvRanges();
  }

  function uSrvRanges() {
    // Aggiorna il valore € stimato accanto a ogni servizio in base al MEP corrente
    const t = document.getElementById("tipo").value;
    const mq = parseFloat(document.getElementById("mq").value) || 0;
    const cx = parseFloat(document.getElementById("cx").value) / 100;
    const p = P[t];
    if (!p || mq <= 0) {
      Object.keys(SRV).forEach(k => { const el = document.getElementById("sv-" + k); if (el) el.textContent = ""; });
      return;
    }
    let mi0 = 0;
    DD.forEach(d => { if (!act.has(d.id)) return; const [mn, mx] = p[d.id]; mi0 += lerp(mn*mq, mx*mq, cx); });
    Object.keys(SRV).forEach(k => {
      const s = SRV[k];
      const v = mi0 * lerp(s.pct[0], s.pct[1], cx);
      const el = document.getElementById("sv-" + k);
      if (el) el.textContent = mi0 > 0 ? "stima " + fmt(v) : "";
    });
  }

  function uR(){const t=document.getElementById("tipo").value;const mq=parseFloat(document.getElementById("mq").value)||0;const p=P[t];if(!p)return;DD.forEach(d=>{const el=document.getElementById("r-"+d.id);if(!el)return;const[mn,mx]=p[d.id];el.textContent=mq>0?fmt(mn*mq)+" – "+fmt(mx*mq):mn+" – "+mx+" €/mq";});}

  function fmt(n){return"€"+Math.round(n).toLocaleString("it-IT");}
  function lerp(a,b,t){return a+(b-a)*t;}

  function calc(){
    uR();
    uSrvRanges();
    const t=document.getElementById("tipo").value;
    const mq=parseFloat(document.getElementById("mq").value)||0;
    const cx=parseFloat(document.getElementById("cx").value)/100;
    const cxL=cx<0.3?"Standard":cx<0.6?"Media":cx<0.85?"Elevata":"Molto elevata";
    document.getElementById("cxl").textContent=cxL;
    const p=P[t];const rows=[];let mn0=0,mi0=0,mx0=0;
    DD.forEach(d=>{if(!act.has(d.id))return;const[mn,mx]=p[d.id];const minV=mn*mq,maxV=mx*mq,midV=lerp(minV,maxV,cx);mn0+=minV;mi0+=midV;mx0+=maxV;rows.push({label:d.label,min:minV,mid:midV,max:maxV});});
    const pMn=mn0*lerp(PARC[0],PARC[1],0.3);
    const pMi=mi0*lerp(PARC[0],PARC[1],cx);
    const pMx=mx0*lerp(PARC[0],PARC[1],0.85);

    // Calcolo servizi opzionali attivi (% sul MEP stimato)
    const srvRows = [];
    let srvMin = 0, srvMid = 0, srvMax = 0;
    Object.keys(SRV).forEach(k => {
      if (!actS.has(k)) return;
      const s = SRV[k];
      const sMin = mn0 * s.pct[0];
      const sMax = mx0 * s.pct[1];
      const sMid = mi0 * lerp(s.pct[0], s.pct[1], cx);
      srvMin += sMin; srvMid += sMid; srvMax += sMax;
      srvRows.push({ label: s.label, min: sMin, mid: sMid, max: sMax, pctMin: s.pct[0], pctMax: s.pct[1] });
    });

    const r=document.getElementById("res");
    if(!rows.length||mq<=0){r.innerHTML="<div class='empty'>Inserisci superficie e seleziona almeno una disciplina.</div>";return;}
    r.innerHTML=`
      <div class="sl">Riepilogo stima</div>
      <div class="mr">
        <div class="mt"><div class="ml">Valore MEP min</div><div class="mv">${fmt(mn0)}</div><div class="ms">${Math.round(mn0/mq).toLocaleString("it-IT")} €/mq</div></div>
        <div class="mt hi"><div class="ml">Valore MEP stimato</div><div class="mv">${fmt(mi0)}</div><div class="ms">${Math.round(mi0/mq).toLocaleString("it-IT")} €/mq · ${cxL.toLowerCase()}</div></div>
        <div class="mt"><div class="ml">Valore MEP max</div><div class="mv">${fmt(mx0)}</div><div class="ms">${Math.round(mx0/mq).toLocaleString("it-IT")} €/mq</div></div>
      </div>
      <div class="bh"><span>Disciplina</span><span class="nr">Min</span><span class="nr">Stimato</span><span class="nr">Max</span></div>
      ${rows.map(r=>`<div class="br"><span style="font-weight:500">${r.label}</span><span class="nr">${fmt(r.min)}</span><span class="nm">${fmt(r.mid)}</span><span class="nr">${fmt(r.max)}</span></div>`).join("")}
      <div class="bt"><span>Totale MEP</span><span class="nr">${fmt(mn0)}</span><span class="nm">${fmt(mi0)}</span><span class="nr">${fmt(mx0)}</span></div>
      <div class="div"></div>
      <div class="sl">Parcella SFW — stima</div>
      <div class="mr">
        <div class="mt"><div class="ml">Parcella min</div><div class="mv">${fmt(pMn)}</div><div class="ms">${(lerp(PARC[0],PARC[1],0.3)*100).toFixed(1)}% del MEP</div></div>
        <div class="mt hi"><div class="ml">Parcella stimata</div><div class="mv">${fmt(pMi)}</div><div class="ms">${(lerp(PARC[0],PARC[1],cx)*100).toFixed(1)}% del MEP stimato</div></div>
        <div class="mt"><div class="ml">Parcella max</div><div class="mv">${fmt(pMx)}</div><div class="ms">${(lerp(PARC[0],PARC[1],0.85)*100).toFixed(1)}% del MEP</div></div>
      </div>
      ${srvRows.length ? `
        <div class="div"></div>
        <div class="sl">Servizi opzionali — stima</div>
        <div class="sbh"><span>Servizio</span><span class="nr">Stimato</span><span class="nr">Range</span></div>
        ${srvRows.map(s => `<div class="sbr"><span style="font-weight:500">${s.label}</span><span class="nr nm">${fmt(s.mid)}</span><span class="nr" style="color:#888;font-size:12px;">${fmt(s.min)} – ${fmt(s.max)}</span></div>`).join("")}
        <div class="sbt"><span>Totale servizi opzionali</span><span class="nr">${fmt(srvMid)}</span><span class="nr" style="color:#888;font-weight:500;">${fmt(srvMin)} – ${fmt(srvMax)}</span></div>
      ` : ""}

      <div class="div"></div>
      <div class="sl">Impatto Fee Waiver — totale a carico del cliente per scenario</div>

      ${(() => {
        const bonusVal = pMi * FW.bonus_pct;
        const cashVal = pMi * FW.cashback_pct;
        const tot1 = pMi + bonusVal;
        const tot2 = pMi;

        return `
        <p style="font-size:11px;color:#888;margin-bottom:6px;font-style:italic;">
          I servizi opzionali, se selezionati, sono fatturati separatamente e non rientrano nel meccanismo Fee Waiver.
        </p>

        <div class="sc-box sc-box--win">
          <div class="sc-head">
            <span class="sc-tag">Scenario 1</span>
            <span class="sc-desc">Supply SFW — Valore parcella + bonus cliente ${(FW.bonus_pct*100).toFixed(0)}%</span>
          </div>
          <div class="sc-tot">${fmt(tot1)}</div>
          <div class="sc-detail">
            (parcella ${fmt(pMi)} + bonus ${fmt(bonusVal)})
          </div>
        </div>

        <div class="sc-box">
          <div class="sc-head">
            <span class="sc-tag">Scenario 2</span>
            <span class="sc-desc">Brand conformi — Fee Waiver pieno</span>
          </div>
          <div class="sc-tot">${fmt(tot2)}</div>
          <div class="sc-detail">
            (parcella ${fmt(pMi)})
          </div>
        </div>

        <div class="sc-box sc-box--alt">
          <div class="sc-head">
            <span class="sc-tag">Scenario 3</span>
            <span class="sc-desc">Brand non conformi — cashback ${(FW.cashback_pct*100).toFixed(0)}% su prossimo incarico</span>
          </div>
          <div class="sc-tot">${fmt(cashVal)}</div>
          <div class="sc-detail">
            (cashback ${(FW.cashback_pct*100).toFixed(0)}% sulla parcella ${fmt(pMi)})
          </div>
        </div>`;
      })()}`;
  }

  function renderPT(){const t=document.getElementById("cts").value;const p=P[t];document.getElementById("bdel").style.display=p.custom?"inline-block":"none";document.getElementById("rename-input").value=p.label;let h=`<table class="pt"><thead><tr><th>Disciplina</th><th>Min (€/mq)</th><th>Max (€/mq)</th></tr></thead><tbody>`;DD.forEach(d=>{const[mn,mx]=p[d.id];h+=`<tr><td>${d.label}</td><td><input class="pi" type="number" id="pm-${d.id}-min" value="${mn}" min="0" step="1"/></td><td><input class="pi" type="number" id="pm-${d.id}-max" value="${mx}" min="0" step="1"/></td></tr>`;});h+=`</tbody></table>`;document.getElementById("pw").innerHTML=h;}

  function saveP(){const t=document.getElementById("cts").value;DD.forEach(d=>{const mn=parseFloat(document.getElementById(`pm-${d.id}-min`).value)||0;const mx=parseFloat(document.getElementById(`pm-${d.id}-max`).value)||0;P[t][d.id]=[Math.min(mn,mx),Math.max(mn,mx)];});saveS();bDG();calc();toast("Parametri salvati");}

  function resetP(){const t=document.getElementById("cts").value;if(DEF[t]){P[t]=JSON.parse(JSON.stringify(DEF[t]));renderPT();saveS();bDG();calc();toast("Parametri ripristinati");}else{toast("Nessun default originale per questa destinazione");}}

  function renameTipo(){const t=document.getElementById("cts").value;if(!P[t])return;const newName=document.getElementById("rename-input").value.trim();if(!newName){toast("Inserisci un nome valido");return;}if(newName===P[t].label){toast("Nome invariato");return;}P[t].label=newName;saveS();const cur=document.getElementById("tipo").value;bSel("cts",t);bSel("tipo",cur);calc();toast("Destinazione rinominata");}

  function delTipo(){const t=document.getElementById("cts").value;if(!P[t].custom)return;if(!confirm("Eliminare questa destinazione?"))return;delete P[t];saveS();bSel("cts",null);bSel("tipo",null);renderPT();calc();toast("Eliminata");}

  function toggleNF(){snf=!snf;const f=document.getElementById("nf");f.style.display=snf?"block":"none";if(snf){let h="";DD.forEach(d=>{h+=`<div class="fr"><label>${d.label}</label><input class="pi" type="number" id="new-${d.id}-min" placeholder="min" min="0" step="1" style="width:70px;"/><span style="color:#888;"> – </span><input class="pi" type="number" id="new-${d.id}-max" placeholder="max" min="0" step="1" style="width:70px;"/></div>`;});document.getElementById("npg").innerHTML=h;}}

  function addNew(){const lbl=document.getElementById("nl").value.trim();if(!lbl){toast("Inserisci il nome");return;}const k="c_"+Date.now();const e={label:lbl,custom:true};DD.forEach(d=>{const mn=parseFloat(document.getElementById(`new-${d.id}-min`).value)||0;const mx=parseFloat(document.getElementById(`new-${d.id}-max`).value)||0;e[d.id]=[Math.min(mn,mx)||mn,Math.max(mn,mx)||mn];});P[k]=e;saveS();bSel("cts",k);bSel("tipo",k);renderPT();calc();toggleNF();toast("Destinazione aggiunta");}

  function renderFwInputs() {
    const b = document.getElementById("fw-bonus");
    const c = document.getElementById("fw-cashback");
    if (b) b.value = (FW.bonus_pct * 100).toFixed(1);
    if (c) c.value = (FW.cashback_pct * 100).toFixed(1);
  }

  function saveFwParams() {
    const b = parseFloat(document.getElementById("fw-bonus").value) || 0;
    const c = parseFloat(document.getElementById("fw-cashback").value) || 0;
    FW.bonus_pct = b / 100;
    FW.cashback_pct = c / 100;
    saveFw();
    calc();
    toast("Bonus e cashback salvati");
  }

  function resetFwParams() {
    FW = JSON.parse(JSON.stringify(FW_DEF));
    saveFw();
    renderFwInputs();
    calc();
    toast("Bonus & cashback ripristinati");
  }

  function renderSrvTable() {
    let h = `<table class="stl"><thead><tr><th>Servizio</th><th style="width:90px">Min %</th><th style="width:90px">Max %</th></tr></thead><tbody>`;
    Object.keys(SRV).forEach(k => {
      const s = SRV[k];
      h += `<tr>
        <td><input class="lbl-input" type="text" id="sl-${k}" value="${s.label}"/></td>
        <td><input class="sin" type="number" id="sp-${k}-min" value="${(s.pct[0]*100).toFixed(2)}" min="0" max="100" step="0.1"/></td>
        <td><input class="sin" type="number" id="sp-${k}-max" value="${(s.pct[1]*100).toFixed(2)}" min="0" max="100" step="0.1"/></td>
      </tr>`;
    });
    h += `</tbody></table>`;
