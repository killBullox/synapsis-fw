  function switchTab(id){
    const order = ["calc", "config", "contract", "margin"];
    document.querySelectorAll(".wrap .tab").forEach((t,i) => t.classList.toggle("active", order[i] === id));
    document.querySelectorAll(".wrap .panel").forEach(p => p.classList.remove("active"));
    document.getElementById("tab-" + id).classList.add("active");
    if (id === "config") { bSel("cts", document.getElementById("tipo").value); renderPT(); renderSrvTable(); renderFwInputs(); }
    if (id === "contract") { populateContractFields(); }
    if (id === "margin") { populateMarginFields(); }
  }

  // Calcola la % parcella corrente (lerp tra 4-7% in base a complessità)
  function getCurrentFeePct() {
    const cx = parseFloat(document.getElementById("cx").value) / 100;
    return lerp(PARC[0], PARC[1], cx) * 100;  // in %
  }

  // Popola i campi della tab Margini SFW
  function populateMarginFields() {
    const feePct = getCurrentFeePct();
    const refEl = document.getElementById("m-fee-pct-ref");
    const costEl = document.getElementById("m-cost-pct");
    const markupEl = document.getElementById("m-srv-markup");
    if (refEl) refEl.value = feePct.toFixed(2) + "%";
    // Default costo = feePct - 1pt; non sovrascrive se utente ha già valore in pagina
    if (costEl && (!costEl.value || costEl.dataset.user !== "1")) {
      costEl.value = Math.max(0, feePct - 1).toFixed(2);
    }
    // Markup servizi: usa il valore salvato
    if (markupEl) markupEl.value = (srvMarkup * 100).toFixed(1);
    // Project Incentive: usa il valore salvato
    const piEl = document.getElementById("m-pi-pct");
    if (piEl) piEl.value = (piPct * 100).toFixed(1);
    recalcMargin();
  }

  function recalcMargin() {
    const t = document.getElementById("tipo").value;
    const mq = parseFloat(document.getElementById("mq").value) || 0;
    const cx = parseFloat(document.getElementById("cx").value) / 100;
    const p = P[t];

    let mi0 = 0;
    DD.forEach(d => { if (!act.has(d.id)) return; const [mn, mx] = p[d.id]; mi0 += lerp(mn*mq, mx*mq, cx); });

    // Totale servizi opzionali attivi (stima MEP * pct media)
    let srvTot = 0;
    Object.keys(SRV).forEach(k => {
      if (!actS.has(k)) return;
      const s = SRV[k];
      srvTot += mi0 * lerp(s.pct[0], s.pct[1], cx);
    });

    const fee = mi0 * lerp(PARC[0], PARC[1], cx);
    const costPct = parseFloat(document.getElementById("m-cost-pct").value) || 0;
    const cost = mi0 * (costPct / 100);
    const bonus = fee * FW.bonus_pct;
    const cashback = fee * FW.cashback_pct;
    const srvMargin = srvTot * srvMarkup;
    const pi = mi0 * piPct;  // Project Incentive sul MEP — solo Sc.1 e Sc.2

    // Margine totale per scenario = margine parcella + margine servizi + PI (Sc.1/2)
    // Sc.3 sottrae anche il cashback dovuto sul prossimo incarico, niente PI
    const m1Parc = fee - cost - bonus;
    const m2Parc = fee - cost;
    const m3Parc = fee - cost - cashback;
    const margin1 = m1Parc + srvMargin + pi;
    const margin2 = m2Parc + srvMargin + pi;
    const margin3 = m3Parc + srvMargin;

    // Update box riepilogo in alto
    const feeValEl = document.getElementById("m-fee-val");
    const feeInfoEl = document.getElementById("m-fee-pct-info");
    const srvValEl = document.getElementById("m-srv-val");
    const srvInfoEl = document.getElementById("m-srv-info");
    if (feeValEl) feeValEl.textContent = fmt(fee);
    if (feeInfoEl) feeInfoEl.textContent = mi0 > 0 ? `${getCurrentFeePct().toFixed(2)}% del MEP stimato` : "";
    if (srvValEl) srvValEl.textContent = fmt(srvTot);
    if (srvInfoEl) {
      const cnt = actS.size;
      srvInfoEl.textContent = cnt === 0 ? "Nessun servizio selezionato" : `${cnt} servizi opzionali · markup ${(srvMarkup*100).toFixed(1)}%`;
    }

    const box = document.getElementById("m-scenarios");
    if (!box) return;

    if (mi0 <= 0) {
      box.innerHTML = `<div class="empty">Inserisci superficie e seleziona almeno una disciplina nel tab Calcolo.</div>`;
      return;
    }

    const srvMarginLine = srvMargin > 0
      ? ` <span class="sc-bonus">+ ${fmt(srvMargin)} margine servizi (${(srvMarkup*100).toFixed(0)}% su ${fmt(srvTot)})</span>`
      : "";
    const piLine = ` <span class="sc-bonus">+ ${fmt(pi)} Project Incentive (${(piPct*100).toFixed(0)}% del MEP)</span>`;

    box.innerHTML = `
      <div class="sl">Margine SFW per scenario</div>
      <p style="font-size:11px;color:#888;margin-bottom:6px;font-style:italic;">
        MEP stimato ${fmt(mi0)} · parcella ${fmt(fee)} · costo parcelle ${fmt(cost)} · PI ${(piPct*100).toFixed(0)}% = ${fmt(pi)}${srvTot > 0 ? ` · servizi ${fmt(srvTot)} (markup ${(srvMarkup*100).toFixed(0)}% = ${fmt(srvMargin)})` : ""}
      </p>

      <div class="sc-box sc-box--win">
        <div class="sc-head"><span class="sc-tag">Scenario 1</span><span class="sc-desc">Supply SFW · margine netto dopo bonus al cliente</span></div>
        <div class="sc-tot">${fmt(margin1)}</div>
        <div class="sc-detail">
          (parcella ${fmt(fee)} − costi ${fmt(cost)} − bonus ${fmt(bonus)} = ${fmt(m1Parc)})${srvMarginLine}${piLine}
        </div>
      </div>

      <div class="sc-box">
        <div class="sc-head"><span class="sc-tag">Scenario 2</span><span class="sc-desc">Brand conformi · Fee Waiver pieno</span></div>
        <div class="sc-tot">${fmt(margin2)}</div>
        <div class="sc-detail">
          (parcella ${fmt(fee)} − costi ${fmt(cost)} = ${fmt(m2Parc)})${srvMarginLine}${piLine}
        </div>
      </div>

      <div class="sc-box sc-box--alt">
        <div class="sc-head"><span class="sc-tag">Scenario 3</span><span class="sc-desc">Brand non conformi · margine al netto del cashback futuro · no Project Incentive</span></div>
        <div class="sc-tot">${fmt(margin3)}</div>
        <div class="sc-detail">
          (parcella ${fmt(fee)} − costi ${fmt(cost)} − cashback ${fmt(cashback)} = ${fmt(m3Parc)})${srvMarginLine}
        </div>
      </div>`;
  }

  // Popola i campi del tab Contratto con i valori del calcolo corrente
  function populateContractFields() {
    const t = document.getElementById("tipo").value;
    const mq = parseFloat(document.getElementById("mq").value) || 0;
    const cx = parseFloat(document.getElementById("cx").value) / 100;
    const p = P[t];

    let mn0 = 0, mi0 = 0, mx0 = 0;
    DD.forEach(d => { if (!act.has(d.id)) return; const [mn, mx] = p[d.id]; mn0 += mn*mq; mi0 += lerp(mn*mq, mx*mq, cx); mx0 += mx*mq; });
    const feeAmt = mi0 * lerp(PARC[0], PARC[1], cx);

    // Parcella
    const feeInput = document.getElementById("c-fee");
    if (feeInput) feeInput.value = Math.round(feeAmt);

    // Servizi aggiuntivi — un campo per ogni servizio attivo
    const wrap = document.getElementById("c-srv-wrap");
    if (wrap) {
      if (actS.size === 0) {
        wrap.innerHTML = '<p style="font-size:12px;color:#888;margin:0.5rem 0;">Nessun servizio opzionale selezionato nel tab Calcolo.</p>';
      } else {
        let html = '<div style="font-size:11px;font-weight:600;color:#666;text-transform:uppercase;letter-spacing:.05em;margin:0.5rem 0;">Servizi opzionali (€)</div>';
        Array.from(actS).forEach(k => {
          const s = SRV[k];
          if (!s) return;
          const v = mi0 * lerp(s.pct[0], s.pct[1], cx);
          html += `<div class="field" style="margin-bottom:0.5rem;display:flex;align-items:center;gap:8px;">
            <label style="flex:1;font-size:13px;">${s.label}</label>
            <input type="number" data-srv-id="${k}" data-srv-label="${s.label}" class="c-srv-input" value="${Math.round(v)}" min="0" step="100" style="width:140px;text-align:right;" />
          </div>`;
        });
        wrap.innerHTML = html;
        // Wire input listeners
        wrap.querySelectorAll(".c-srv-input").forEach(inp => inp.addEventListener("input", recalcContractScenarios));
      }
    }

    recalcContractScenarios();
  }

  // Ricalcola e aggiorna il box scenari nel tab Contratto in base ai valori editati
  function recalcContractScenarios() {
    const fee = parseFloat(document.getElementById("c-fee").value) || 0;
    let srvTot = 0;
    document.querySelectorAll(".c-srv-input").forEach(inp => {
      srvTot += parseFloat(inp.value) || 0;
    });
    const bonusVal = fee * FW.bonus_pct;
    const cashVal = fee * FW.cashback_pct;
    const tot1 = fee + bonusVal;
    const tot2 = fee;

    const box = document.getElementById("c-scenarios");
    if (!box) return;
    const srvNote = srvTot > 0
      ? `<p style="font-size:11px;color:#888;margin-bottom:6px;font-style:italic;">Servizi opzionali ${fmt(srvTot)} fatturati separatamente — non inclusi nel Fee Waiver.</p>`
      : `<p style="font-size:11px;color:#888;margin-bottom:6px;font-style:italic;">I servizi opzionali sono fatturati separatamente e non rientrano nel meccanismo Fee Waiver.</p>`;
    box.innerHTML = `
      <div class="sl">Riepilogo scenari Fee Waiver — basato sui valori editati</div>
      ${srvNote}
      <div class="sc-box sc-box--win">
        <div class="sc-head"><span class="sc-tag">Scenario 1</span><span class="sc-desc">Supply SFW · Valore parcella + bonus cliente ${(FW.bonus_pct*100).toFixed(0)}%</span></div>
        <div class="sc-tot">${fmt(tot1)}</div>
        <div class="sc-detail">(parcella ${fmt(fee)} + bonus ${fmt(bonusVal)})</div>
      </div>
      <div class="sc-box">
        <div class="sc-head"><span class="sc-tag">Scenario 2</span><span class="sc-desc">Brand conformi · Fee Waiver pieno</span></div>
        <div class="sc-tot">${fmt(tot2)}</div>
        <div class="sc-detail">(parcella ${fmt(fee)})</div>
      </div>
      <div class="sc-box sc-box--alt">
        <div class="sc-head"><span class="sc-tag">Scenario 3</span><span class="sc-desc">Brand non conformi · cashback ${(FW.cashback_pct*100).toFixed(0)}% su prossimo incarico</span></div>
        <div class="sc-tot">${fmt(cashVal)}</div>
        <div class="sc-detail">(cashback ${(FW.cashback_pct*100).toFixed(0)}% sulla parcella ${fmt(fee)})</div>
      </div>`;
  }

  // Salva dati Synapsis FW in localStorage
  function loadSfwData() {
    try {
      const d = JSON.parse(localStorage.getItem('sfw-prof-data') || '{}');
      if (d.seat) document.getElementById("c-sfw-seat").value = d.seat;
      if (d.vat) document.getElementById("c-sfw-vat").value = d.vat;
      if (d.legal) document.getElementById("c-sfw-legal").value = d.legal;
    } catch (e) {}
  }
  function saveSfwData() {
    const d = {
      seat: document.getElementById("c-sfw-seat").value.trim(),
      vat: document.getElementById("c-sfw-vat").value.trim(),
      legal: document.getElementById("c-sfw-legal").value.trim(),
    };
    try { localStorage.setItem('sfw-prof-data', JSON.stringify(d)); toast("Dati SFW salvati"); } catch (e) {}
  }

  // Raccoglie tutto dal calcolatore + form contratto, salva in sessionStorage e apre la pagina
  function generateContract() {
    const t = document.getElementById("tipo").value;
    const mq = parseFloat(document.getElementById("mq").value) || 0;
    const p = P[t];

    // Discipline attive con label
    const discLabels = DD.filter(d => act.has(d.id)).map(d => d.label).join(" · ");

    // Parcella e servizi: usa i valori EDITATI nel tab Contratto
    const feeAmt = parseFloat(document.getElementById("c-fee").value) || 0;

    const srvLines = [];
    let srvTot = 0;
    document.querySelectorAll(".c-srv-input").forEach(inp => {
      const v = parseFloat(inp.value) || 0;
      const lbl = inp.getAttribute("data-srv-label") || "Servizio";
      if (v > 0) {
        srvTot += v;
        srvLines.push(`${lbl}: € ${Math.round(v).toLocaleString('it-IT')}`);
      }
    });

    const scenarioLabels = {
      "1": "Scenario 1 — Supply SFW (Fee Waiver pieno + bonus)",
      "2": "Scenario 2 — Brand conformi (Fee Waiver pieno)",
      "3": "Scenario 3 — Brand non conformi (parcella intera + cashback)",
    };

    const today = new Date();
    const todayStr = today.getDate().toString().padStart(2,'0') + "/" + (today.getMonth()+1).toString().padStart(2,'0') + "/" + today.getFullYear();

    const data = {
      // Progetto
      proj_name: document.getElementById("c-proj-name").value.trim(),
      proj_type: p.label,
      proj_address: document.getElementById("c-proj-address").value.trim(),
      proj_surface: mq.toLocaleString('it-IT'),
      proj_phase: document.getElementById("c-proj-phase").value,
      proj_disciplines: discLabels,
      proj_services: srvLines.length ? srvLines.map(l => l.split(':')[0]).join(' · ') : "Nessuno",
      services_fee: srvLines.length ? srvLines.join(' — ') + ` (totale € ${Math.round(srvTot).toLocaleString('it-IT')})` : "Non applicabile",

      // Economia
      fee_amount: Math.round(feeAmt).toLocaleString('it-IT'),
      fee_vat: document.getElementById("c-vat").value,
      fw_scenario: scenarioLabels[document.getElementById("c-scenario").value],
      bonus_pct: (FW.bonus_pct * 100).toFixed(0),
      cashback_amount: Math.round(feeAmt * FW.cashback_pct).toLocaleString('it-IT'),
      delivery_days: document.getElementById("c-delivery-days").value,
      cronoprogramma: document.getElementById("c-crono").value.trim(),
      foro: document.getElementById("c-foro").value.trim(),

      // Cliente
      client_name: document.getElementById("c-cli-name").value.trim(),
      client_form: document.getElementById("c-cli-form").value.trim(),
      client_seat: document.getElementById("c-cli-seat").value.trim(),
      client_vat: document.getElementById("c-cli-vat").value.trim(),
      client_legal: document.getElementById("c-cli-legal").value.trim(),
      client_pec: document.getElementById("c-cli-pec").value.trim(),
      client_phone: document.getElementById("c-cli-phone").value.trim(),

      // SFW
      sfw_seat: document.getElementById("c-sfw-seat").value.trim(),
      sfw_vat: document.getElementById("c-sfw-vat").value.trim(),
      sfw_legal: document.getElementById("c-sfw-legal").value.trim(),

      // Stipula
      sign_date: todayStr,
      sign_place: document.getElementById("c-sign-place").value.trim() || "Napoli",
    };

    sessionStorage.setItem('sfw-contract-data', JSON.stringify(data));
    saveSfwData();
    window.open('/area-riservata/contratto/', '_blank');
  }

  // Espongo le funzioni inline
  window.calc = calc;
  window.switchTab = switchTab;
  window.renderPT = renderPT;
  window.saveP = saveP;
  window.resetP = resetP;
  window.delTipo = delTipo;
  window.toggleNF = toggleNF;
  window.addNew = addNew;
  window.renameTipo = renameTipo;

  // ============================
  // GESTIONE PROGETTI
  // ============================
  const PROJ_KEY = 'sfw-projects-v1';
  const PROJ_CURRENT_KEY = 'sfw-project-current';
  let projects = [];
  let currentProjectId = null;
  let dirty = false;

  function loadProjects() {
    try {
      const s = localStorage.getItem(PROJ_KEY);
      projects = s ? JSON.parse(s) : [];
    } catch { projects = []; }
    try { currentProjectId = localStorage.getItem(PROJ_CURRENT_KEY); } catch {}
  }
  function persistProjects() { try { localStorage.setItem(PROJ_KEY, JSON.stringify(projects)); } catch {} }
  function persistCurrent() { try {
    if (currentProjectId) localStorage.setItem(PROJ_CURRENT_KEY, currentProjectId);
    else localStorage.removeItem(PROJ_CURRENT_KEY);
  } catch {} }

  function setDirty(v) {
    dirty = !!v;
    const el = document.getElementById("proj-dirty");
    if (el) el.style.display = dirty ? "inline" : "none";
  }

  // Raccoglie tutto lo stato corrente in un oggetto serializzabile
  function getCurrentProjectData() {
    const contractServices = {};
    document.querySelectorAll(".c-srv-input").forEach(inp => {
      const id = inp.getAttribute("data-srv-id");
      if (id) contractServices[id] = parseFloat(inp.value) || 0;
    });
    const costEl = document.getElementById("m-cost-pct");
    return {
      // Calcolo
      tipo: document.getElementById("tipo")?.value ?? "",
      mq: parseFloat(document.getElementById("mq")?.value) || 0,
      complexity: parseInt(document.getElementById("cx")?.value) || 50,
      disciplines: Array.from(act),
      services: Array.from(actS),
      // Contratto
      contractFee: parseFloat(document.getElementById("c-fee")?.value) || 0,
      contractServices,
      contractFields: {
        proj_name: document.getElementById("c-proj-name")?.value ?? "",
        proj_address: document.getElementById("c-proj-address")?.value ?? "",
        proj_phase: document.getElementById("c-proj-phase")?.value ?? "Definitivo",
        delivery_days: document.getElementById("c-delivery-days")?.value ?? "60",
        crono: document.getElementById("c-crono")?.value ?? "",
        vat: document.getElementById("c-vat")?.value ?? "22",
        scenario: document.getElementById("c-scenario")?.value ?? "1",
        foro: document.getElementById("c-foro")?.value ?? "Napoli",
        sign_place: document.getElementById("c-sign-place")?.value ?? "",
        cli_name: document.getElementById("c-cli-name")?.value ?? "",
        cli_form: document.getElementById("c-cli-form")?.value ?? "",
        cli_seat: document.getElementById("c-cli-seat")?.value ?? "",
        cli_vat: document.getElementById("c-cli-vat")?.value ?? "",
        cli_legal: document.getElementById("c-cli-legal")?.value ?? "",
        cli_pec: document.getElementById("c-cli-pec")?.value ?? "",
        cli_phone: document.getElementById("c-cli-phone")?.value ?? "",
      },
      // Margini
      costPct: parseFloat(costEl?.value) || null,
      costPctIsUser: costEl?.dataset.user === "1",
    };
  }

  // Applica un set di dati a tutti i campi del calcolatore
  function applyProjectData(d) {
    if (!d) return;
    // Calcolo
    if (d.tipo && document.querySelector(`#tipo option[value="${d.tipo}"]`)) {
      document.getElementById("tipo").value = d.tipo;
    }
    if (d.mq != null) document.getElementById("mq").value = d.mq;
    if (d.complexity != null) document.getElementById("cx").value = d.complexity;
    // Discipline
    act.clear();
    (d.disciplines || []).forEach(id => act.add(id));
    if (act.size === 0) DD.forEach(x => act.add(x.id));
    // Servizi
    actS.clear();
    (d.services || []).forEach(id => actS.add(id));
    bDG();
    bSG();
    // Contratto
    if (d.contractFields) {
      const cf = d.contractFields;
      const set = (id, v) => { const el = document.getElementById(id); if (el && v !== undefined) el.value = v; };
      set("c-proj-name", cf.proj_name);
      set("c-proj-address", cf.proj_address);
      set("c-proj-phase", cf.proj_phase);
      set("c-delivery-days", cf.delivery_days);
      set("c-crono", cf.crono);
      set("c-vat", cf.vat);
      set("c-scenario", cf.scenario);
      set("c-foro", cf.foro);
      set("c-sign-place", cf.sign_place);
      set("c-cli-name", cf.cli_name);
      set("c-cli-form", cf.cli_form);
      set("c-cli-seat", cf.cli_seat);
      set("c-cli-vat", cf.cli_vat);
      set("c-cli-legal", cf.cli_legal);
      set("c-cli-pec", cf.cli_pec);
      set("c-cli-phone", cf.cli_phone);
    }
    // Margini — costPct: se era user-edited, lo ripristina; altrimenti lascia auto-default
    const costEl = document.getElementById("m-cost-pct");
    if (costEl) {
      if (d.costPctIsUser && d.costPct != null) {
        costEl.value = d.costPct;
        costEl.dataset.user = "1";
      } else {
        costEl.value = "";
        costEl.dataset.user = "0";
      }
    }
    // Ricalcola
    calc();
    // Se siamo nel tab Contratto/Margini, ripopolo
    populateContractFields();
    populateMarginFields();
    // Override parcella editata e servizi (dopo populateContractFields li ricalcola dal MEP)
    if (d.contractFee != null) {
      const fEl = document.getElementById("c-fee");
      if (fEl) fEl.value = d.contractFee;
    }
    if (d.contractServices) {
      Object.keys(d.contractServices).forEach(id => {
        const inp = document.querySelector(`.c-srv-input[data-srv-id="${id}"]`);
        if (inp) inp.value = d.contractServices[id];
      });
    }
    recalcContractScenarios();
    recalcMargin();
  }

  function rebuildProjSelect() {
    const sel = document.getElementById("proj-select");
    if (!sel) return;
    sel.innerHTML = '<option value="">— Nessun progetto attivo —</option>';
    projects
      .slice()
      .sort((a,b) => (b.updatedAt||0) - (a.updatedAt||0))
      .forEach(p => {
        const o = document.createElement("option");
        o.value = p.id;
        o.textContent = p.name;
        if (p.id === currentProjectId) o.selected = true;
        sel.appendChild(o);
      });
    const delBtn = document.getElementById("btn-proj-delete");
    if (delBtn) delBtn.style.display = currentProjectId ? "inline-block" : "none";
  }

  function newProject() {
    if (dirty && !confirm("Ci sono modifiche non salvate. Vuoi creare un nuovo progetto e perderle?")) return;
    currentProjectId = null;
    persistCurrent();
    // Reset campi a default base
    applyProjectData({
      tipo: "res_prem", mq: 1000, complexity: 50,
      disciplines: DD.map(d => d.id),
      services: [],
      contractFields: { proj_phase: "Definitivo", delivery_days: "60", vat: "22", scenario: "1", foro: "Napoli" },
    });
    rebuildProjSelect();
    setDirty(false);
    toast("Nuovo progetto");
  }

  function saveProject(forceNewName = false) {
    const data = getCurrentProjectData();
    if (currentProjectId && !forceNewName) {
      const p = projects.find(x => x.id === currentProjectId);
      if (p) {
        p.data = data;
        p.updatedAt = Date.now();
        persistProjects();
        rebuildProjSelect();
        setDirty(false);
        toast("Progetto salvato");
        return;
      }
    }
    // Nuovo o "salva con nome"
    const suggested = data.contractFields?.proj_name || data.contractFields?.cli_name || `Progetto ${new Date().toLocaleDateString("it-IT")}`;
    const name = prompt("Nome del progetto:", suggested);
    if (!name) return;
    const id = "p_" + Date.now() + "_" + Math.random().toString(36).slice(2,7);
    projects.push({ id, name: name.trim(), data, createdAt: Date.now(), updatedAt: Date.now() });
    currentProjectId = id;
    persistProjects();
    persistCurrent();
    rebuildProjSelect();
    setDirty(false);
    toast("Progetto creato e salvato");
  }

  function loadProject(id) {
    const p = projects.find(x => x.id === id);
    if (!p) return;
    if (dirty && !confirm("Ci sono modifiche non salvate sul progetto attuale. Continuare comunque?")) {
      // Ripristina selezione
      document.getElementById("proj-select").value = currentProjectId || "";
      return;
    }
    currentProjectId = id;
    persistCurrent();
    applyProjectData(p.data);
    rebuildProjSelect();
    setDirty(false);
    toast(`Caricato: ${p.name}`);
  }

  function deleteProject() {
    if (!currentProjectId) return;
    const p = projects.find(x => x.id === currentProjectId);
    if (!p) return;
    if (!confirm(`Eliminare definitivamente il progetto "${p.name}"?`)) return;
    projects = projects.filter(x => x.id !== currentProjectId);
    currentProjectId = null;
    persistProjects();
    persistCurrent();
    rebuildProjSelect();
    toast("Progetto eliminato");
  }

  function exportProjects() {
    const blob = new Blob([JSON.stringify(projects, null, 2)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `sfw-progetti-${new Date().toISOString().slice(0,10)}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
    toast(`Esportati ${projects.length} progetti`);
  }

  function importProjects(file) {
    const reader = new FileReader();
    reader.onload = e => {
      try {
        const arr = JSON.parse(e.target.result);
        if (!Array.isArray(arr)) throw new Error("Formato non valido");
        const existingIds = new Set(projects.map(p => p.id));
        let added = 0;
        arr.forEach(p => {
          if (p && p.id && p.name && p.data && !existingIds.has(p.id)) {
            projects.push(p);
            added++;
          }
        });
        persistProjects();
        rebuildProjSelect();
        toast(`Importati ${added} progetti (${arr.length - added} duplicati ignorati)`);
      } catch (err) {
        toast("Errore: file JSON non valido");
      }
    };
    reader.readAsText(file);
  }

  // Listener — segna come dirty su ogni modifica
  function markDirtyOnInput() {
    const watch = ["tipo","mq","cx","c-fee","c-proj-name","c-proj-address","c-proj-phase","c-delivery-days","c-crono","c-vat","c-scenario","c-foro","c-sign-place","c-cli-name","c-cli-form","c-cli-seat","c-cli-vat","c-cli-legal","c-cli-pec","c-cli-phone"];
    watch.forEach(id => {
      const el = document.getElementById(id);
      el?.addEventListener("input", () => setDirty(true));
      el?.addEventListener("change", () => setDirty(true));
    });
    document.getElementById("dg")?.addEventListener("click", () => setDirty(true));
    document.getElementById("sg")?.addEventListener("click", () => setDirty(true));
    document.addEventListener("input", e => {
      const t = e.target;
      if (t && t.classList && t.classList.contains("c-srv-input")) setDirty(true);
    });
  }

  document.getElementById("btn-proj-new")?.addEventListener("click", newProject);
  document.getElementById("btn-proj-save")?.addEventListener("click", () => saveProject(false));
  document.getElementById("btn-proj-saveas")?.addEventListener("click", () => saveProject(true));
  document.getElementById("btn-proj-delete")?.addEventListener("click", deleteProject);
  document.getElementById("btn-proj-export")?.addEventListener("click", exportProjects);
  document.getElementById("btn-proj-import")?.addEventListener("click", () => document.getElementById("proj-file").click());
  document.getElementById("proj-file")?.addEventListener("change", e => {
    const f = e.target.files?.[0];
    if (f) importProjects(f);
    e.target.value = "";
  });
  document.getElementById("proj-select")?.addEventListener("change", e => {
    const id = e.target.value;
    if (!id) { currentProjectId = null; persistCurrent(); rebuildProjSelect(); return; }
    loadProject(id);
  });

  // ============================

  loadS();
  bSel("tipo", null);
  bSel("cts", null);
  bDG();
  bSG();
  calc();

  // Carica progetti e applica eventuale progetto corrente
  loadProjects();
  rebuildProjSelect();
  if (currentProjectId) {
    const p = projects.find(x => x.id === currentProjectId);
    if (p) applyProjectData(p.data);
  }
  markDirtyOnInput();
  setDirty(false);

  document.getElementById("btn-save-srv")?.addEventListener("click", saveSrvParams);
  document.getElementById("btn-reset-srv")?.addEventListener("click", resetSrvParams);
  document.getElementById("btn-save-fw")?.addEventListener("click", saveFwParams);
  document.getElementById("btn-reset-fw")?.addEventListener("click", resetFwParams);

  // Tab contratto
  loadSfwData();
  document.getElementById("btn-generate-contract")?.addEventListener("click", generateContract);
  document.getElementById("btn-save-sfw-data")?.addEventListener("click", saveSfwData);
  document.getElementById("c-fee")?.addEventListener("input", recalcContractScenarios);

  // Tab Margini SFW
  const costInput = document.getElementById("m-cost-pct");
  const markupInput = document.getElementById("m-srv-markup");
  const piInput = document.getElementById("m-pi-pct");
  costInput?.addEventListener("input", () => { costInput.dataset.user = "1"; recalcMargin(); });
  markupInput?.addEventListener("input", () => {
    srvMarkup = (parseFloat(markupInput.value) || 0) / 100;
    recalcMargin();
  });
  piInput?.addEventListener("input", () => {
    piPct = (parseFloat(piInput.value) || 0) / 100;
    recalcMargin();
  });
  document.getElementById("btn-save-markup")?.addEventListener("click", () => {
    srvMarkup = (parseFloat(markupInput.value) || 0) / 100;
    piPct = (parseFloat(piInput.value) || 0) / 100;
    saveMarkup();
    savePi();
    toast("Parametri SFW salvati");
  });
  document.getElementById("btn-margin-default")?.addEventListener("click", () => {
    if (costInput) {
      costInput.dataset.user = "0";
      costInput.value = "";
    }
    srvMarkup = SRV_MARKUP_DEF;
    piPct = PI_PCT_DEF;
    saveMarkup();
    savePi();
    populateMarginFields();
    toast("Parametri reimpostati al default");
  });
</script>
