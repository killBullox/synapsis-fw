            <dt>PEC:</dt><dd>synapsisfw@pec.it</dd>
            <dt>Tel:</dt><dd>+39 340 3542476</dd>
          </dl>
        </div>
        <div class="ctr-party">
          <div class="ctr-party-tag">CLIENTE</div>
          <div class="ctr-party-name" data-f="client_name"></div>
          <dl class="ctr-dl">
            <dt>Forma giuridica:</dt><dd data-f="client_form"></dd>
            <dt>Sede legale:</dt><dd data-f="client_seat"></dd>
            <dt>P.IVA / C.F.:</dt><dd data-f="client_vat"></dd>
            <dt>Legale Rapp.te:</dt><dd data-f="client_legal"></dd>
