</style>

<script is:inline>
  // Legge i dati dal sessionStorage e li inietta nei placeholder data-f
  function fillFields() {
    let data = {};
    try {
      const raw = sessionStorage.getItem('sfw-contract-data');
      if (raw) data = JSON.parse(raw);
    } catch (e) {}

    document.querySelectorAll('[data-f]').forEach(el => {
      const key = el.getAttribute('data-f');
      if (data[key]) el.textContent = data[key];
    });
  }

  fillFields();

  // Bottone stampa
  document.getElementById('btn-print')?.addEventListener('click', () => {
    window.print();
  });

  // Export in Word (HTML → .doc, Word lo apre senza problemi e si può risalvare come .docx)
  function exportWord() {
    const ctr = document.getElementById('ctr-content');
    if (!ctr) return;

    // Stili Word-friendly inline (Word non rispetta tutti i CSS moderni come @media print, color-mix, ecc.)
    const wordStyles = `
      <style>
        body { font-family: 'Times New Roman', Georgia, serif; font-size: 11pt; line-height: 1.55; color: #1E1E1E; }
        h1 { font-size: 22pt; font-weight: bold; margin: 0 0 10pt; text-align: center; }
        h2 { font-family: Arial, sans-serif; font-size: 11pt; font-weight: bold; letter-spacing: 1pt; text-transform: uppercase; margin: 20pt 0 10pt; padding-bottom: 4pt; border-bottom: 1pt solid #1E1E1E; }
        h3 { font-family: Arial, sans-serif; font-size: 11pt; font-weight: bold; margin: 14pt 0 6pt; }
        p { margin: 5pt 0; text-align: justify; }
        ul { margin: 5pt 0 10pt 20pt; padding: 0; }
        li { margin: 3pt 0; text-align: justify; }
        table { width: 100%; border-collapse: collapse; font-size: 10.5pt; margin: 8pt 0; }
        td { padding: 5pt 8pt; border-bottom: 0.5pt solid #cccccc; vertical-align: top; }
        td.lbl { font-weight: bold; width: 38%; color: #444; }
        .ctr-cover { text-align: center; padding: 0 0 20pt; border-bottom: 1pt solid #1E1E1E; margin-bottom: 16pt; }
        .ctr-brand { font-family: Arial, sans-serif; font-size: 10pt; color: #E8580A; letter-spacing: 1pt; margin-bottom: 8pt; font-weight: bold; }
        .ctr-sub { font-size: 12pt; color: #444; margin: 0; text-align: center; }
        .ctr-parties { width: 100%; }
        .ctr-party { border: 0.5pt solid #cccccc; padding: 8pt 12pt; margin-bottom: 8pt; background: #fafafa; }
        .ctr-party-tag { font-family: Arial, sans-serif; font-size: 9pt; font-weight: bold; color: #E8580A; letter-spacing: 1pt; margin-bottom: 4pt; }
        .ctr-party-name { font-weight: bold; font-size: 11.5pt; margin-bottom: 2pt; }
        .ctr-party-sub { font-size: 10pt; color: #666; margin-bottom: 4pt; }
        .ctr-dl { margin: 0; font-size: 10pt; }
        .ctr-dl dt { display: inline-block; font-weight: bold; min-width: 100pt; }
        .ctr-dl dd { display: inline; margin: 0; }
        .ctr-meta { padding-top: 8pt; border-top: 0.5pt dashed #cccccc; font-size: 10pt; color: #555; }
        .ctr-fee { background: #fff8f5; border: 0.5pt solid #E8580A; padding: 8pt 12pt; margin: 10pt 0; font-size: 11.5pt; }
        .ctr-note { font-size: 9.5pt; font-style: italic; color: #666; }
        .ctr-1341 { border: 1pt solid #1E1E1E; padding: 8pt 12pt; margin: 14pt 0; }
        .ctr-1341 p { margin: 3pt 0; }
        .ctr-sign-line { border-bottom: 0.5pt solid #1E1E1E; height: 50pt; margin-bottom: 4pt; }
        .ctr-sign-meta { font-size: 9.5pt; color: #555; margin: 2pt 0; }
        .ctr-signs { margin-top: 25pt; }
      </style>`;

    // Sostituisco i [data-f]:empty::after CSS con un placeholder testuale visibile in Word
    let html = ctr.innerHTML;
    // Word non supporta ::after, sostituisco i campi vuoti con underscore visibili
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    tmp.querySelectorAll('[data-f]').forEach((el) => {
      if (!el.textContent.trim()) {
        el.textContent = '____________________';
      }
    });
    // Rendo le sottoscrizioni a 2 colonne come tabella (Word gestisce meglio le tabelle)
    const signGrid = tmp.querySelector('.ctr-sign-grid');
    if (signGrid) {
      const cols = Array.from(signGrid.children);
      if (cols.length === 2) {
        const tbl = document.createElement('table');
        tbl.innerHTML = `<tr><td style="width:50%;border:none;padding-right:15pt;vertical-align:top;">${cols[0].innerHTML}</td><td style="width:50%;border:none;padding-left:15pt;vertical-align:top;">${cols[1].innerHTML}</td></tr>`;
        signGrid.replaceWith(tbl);
      }
    }
    // Idem parti contraenti — 2 colonne come tabella
    const parties = tmp.querySelector('.ctr-parties');
    if (parties) {
      const cols = Array.from(parties.children);
      if (cols.length === 2) {
        const tbl = document.createElement('table');
        tbl.innerHTML = `<tr><td style="width:50%;border:none;padding-right:8pt;vertical-align:top;">${cols[0].outerHTML}</td><td style="width:50%;border:none;padding-left:8pt;vertical-align:top;">${cols[1].outerHTML}</td></tr>`;
        parties.replaceWith(tbl);
      }
    }
    html = tmp.innerHTML;

    const filename = 'Contratto_Synapsis_FW';

    const docHtml = `<!DOCTYPE html>
<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
  <meta charset="utf-8">
  <title>${filename}</title>
  <!--[if gte mso 9]>
  <xml>
    <w:WordDocument>
      <w:View>Print</w:View>
      <w:Zoom>100</w:Zoom>
      <w:DoNotPromptForConvert/>
      <w:DoNotShowRevisions/>
    </w:WordDocument>
  </xml>
  <![endif]-->
  <style>
    @page { size: A4; margin: 2cm; }
    div.WordSection1 { page: WordSection1; }
  </style>
  ${wordStyles}
</head>
<body>
  <div class="WordSection1">
    ${html}
  </div>
</body>
</html>`;

    const blob = new Blob(['﻿', docHtml], { type: 'application/msword' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename + '.doc';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(link.href);
  }

  document.getElementById('btn-export-word')?.addEventListener('click', exportWord);
</script>
