---
// Pagina di presentazione del video PerformAce: non indicizzata, non nel menu, esclusa dalla sitemap.
const video = '/media/performace-video-v1.mp4';
const poster = '/media/performace-poster.jpg';
const steps = [
  { k: 'Misura', t: 'Un dato ogni 15 minuti dal contatore e, dove serve, dalle singole linee.' },
  { k: 'Confronta', t: 'Ogni locale contro il consumo atteso dal suo progetto, non contro gli altri.' },
  { k: 'Ottimizza', t: 'Sprechi trovati senza sopralluogo, clima e luce guidati da un\'AI adattiva.' },
  { k: 'Verifica', t: 'Il risparmio misurato dopo ogni intervento, con un metodo riconosciuto.' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0E2238" />
    <title>PerformAce · Synapsis FW</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --night: #0E2238; --night-2: #08162A; --line: #1f3657;
        --ink: #ECF1FF; --muted: #9db0cc; --amber: #F2A33A; --green: #2E7D6B; --red: #FA4E2D;
        --display: "Bahnschrift", "DIN Alternate", "Segoe UI", system-ui, sans-serif;
        --body: "Segoe UI", system-ui, -apple-system, sans-serif;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--night-2); color: var(--ink); font: 16px/1.6 var(--body); -webkit-font-smoothing: antialiased; }
      body { background: radial-gradient(70% 50% at 50% 0%, rgba(242,163,58,.12), transparent 70%), linear-gradient(180deg, var(--night), var(--night-2) 75%); min-height: 100vh; }
      .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }
      .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px; }
      .top img { height: 40px; width: auto; display: block; }
      .top span { color: var(--muted); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; }
      .hero { padding-block: clamp(24px, 6vw, 60px) 26px; text-align: center; display: grid; gap: 14px; justify-items: center; }
      .eyebrow { color: var(--amber); font-size: 13px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
      h1 { margin: 0; font: 700 clamp(52px, 10vw, 104px)/.95 var(--display); letter-spacing: -.01em; }
      h1 span { color: var(--amber); }
      .claim { margin: 0; font: 600 clamp(19px, 2.6vw, 26px)/1.35 var(--display); max-width: 30ch; text-wrap: balance; }
      .sub { margin: 0; color: var(--muted); max-width: 58ch; text-wrap: balance; }
      .player { margin-block: 18px 8px; border-radius: 14px; padding: 1px; background: linear-gradient(135deg, rgba(242,163,58,.75), rgba(31,54,87,.6) 40%, rgba(242,163,58,.35)); box-shadow: 0 30px 90px rgba(0,0,0,.55), 0 0 80px rgba(242,163,58,.12); }
      .player video { display: block; width: 100%; height: auto; border-radius: 13px; background: #000; }
      .cap { text-align: center; color: var(--muted); font-size: 13px; margin: 6px 0 0; }
      .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-block: 44px 40px; }
      .step { border-top: 2px solid var(--amber); padding-top: 14px; }
      .step:last-child { border-top-color: var(--green); }
      .step h2 { margin: 0 0 6px; font: 700 22px/1.2 var(--display); }
      .step p { margin: 0; color: var(--muted); font-size: 15px; }
      footer { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; padding-block: 24px 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
      footer a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--amber); }
      footer a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
      @media (max-width: 860px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } .top img { height: 32px; } }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="top"><img src="/media/sfw-logo-bianco.png" alt="Synapsis FW" width="170" height="40" /><span>PerformAce</span></div>

      <section class="hero">
        <span class="eyebrow">Prestazioni energetiche delle catene di locali</span>
        <h1>Perform<span>Ace</span></h1>
        <p class="claim">Le prestazioni di ogni locale, sotto controllo.</p>
        <p class="sub">Misura i consumi di ogni locale, li confronta con quelli attesi dal suo progetto, trova gli sprechi, ottimizza clima e luce e verifica il risparmio ottenuto.</p>
      </section>

      <div class="player">
        <video controls playsinline preload="metadata" poster={poster}>
          <source src={video} type="video/mp4" />
          Il browser non riproduce il video: <a href={video}>aprilo qui</a>.
        </video>
      </div>
      <p class="cap">Video di presentazione · 1 minuto e 30 secondi · con audio</p>

      <section class="steps">
        {steps.map((s) => (
          <div class="step">
            <h2>{s.k}</h2>
            <p>{s.t}</p>
          </div>
        ))}
      </section>

      <footer>
        <span>Synapsis FW S.r.l. · Napoli</span>
        <a href="/">synapsisfw.it</a>
      </footer>
    </div>
  </body>
</html>
