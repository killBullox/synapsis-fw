---
// Pagina riservata ai soci We Chiaia: non indicizzata, non nel menu, esclusa dalla sitemap.
const video = '/media/chiaia-pulse-concept.mp4';
const poster = '/media/chiaia-pulse-poster.jpg';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b1626" />
    <title>Chiaia Pulse · We Chiaia</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root { --night: #0b1626; --ink: #e9eef6; --muted: #8fa0b8; --amber: #e8a33d; color-scheme: dark; }
      html, body { margin: 0; background: var(--night); color: var(--ink); font: 16px/1.55 "Segoe UI", system-ui, -apple-system, sans-serif; }
      main { max-width: 1100px; margin: 0 auto; padding-inline: 16px; padding-block: 32px 48px; display: grid; gap: 20px; }
      .eyebrow { color: var(--amber); font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
      h1 { margin: 0; font-size: clamp(32px, 6vw, 56px); line-height: 1.05; font-weight: 700; text-wrap: balance; }
      .lead { margin: 0; color: var(--muted); max-width: 62ch; }
      video { width: 100%; height: auto; border-radius: 8px; background: #000; box-shadow: 0 0 0 1px #1d2e48, 0 20px 60px rgba(0,0,0,.45); }
      .note { color: var(--muted); font-size: 13px; max-width: 75ch; }
      footer { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; border-top: 1px solid #1d2e48; padding-top: 16px; color: var(--muted); font-size: 13px; }
      footer a { color: var(--ink); }
    </style>
  </head>
  <body>
    <main>
      <span class="eyebrow">Per i soci di We Chiaia</span>
      <h1>Chiaia Pulse</h1>
      <p class="lead">Ogni vetrina è un battito. Insieme un quartiere vivo. Il concept del piano di illuminazione permanente dei negozi di Chiaia, verso l'America's Cup 2027.</p>
      <video controls playsinline preload="metadata" poster={poster}>
        <source src={video} type="video/mp4" />
        Il browser non riproduce il video: <a href={video}>aprilo qui</a>.
      </video>
      <p class="note">Concept video per uso interno di We Chiaia. Le simulazioni della luce, i messaggi sugli schermi e il totem in piazza sono indicativi. Foto dei negozi: wechiaia.it, per gentile concessione di We Chiaia; crediti completi nei titoli di coda.</p>
      <footer>
        <span>Synapsis FW S.r.l. · Napoli</span>
        <a href="/">synapsisfw.it</a>
      </footer>
    </main>
  </body>
</html>
