---
// Pagina riservata ai soci We Chiaia: non indicizzata, non nel menu, esclusa dalla sitemap.
const video = '/media/chiaia-pulse-concept-v3.mp4';
const poster = '/media/chiaia-pulse-poster.jpg';
const pillars = [
  { k: 'La soglia', t: 'Portali, cornici e ingressi illuminati con la stessa luce calda in tutto il quartiere.' },
  { k: 'La rete', t: 'Ogni negozio aderente è un nodo: al tramonto un impulso di luce attraversa Chiaia.' },
  { k: 'La voce', t: 'Schermi in vetrina e nelle piazze con messaggi, percorsi e il gioco del network.' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b1626" />
    <title>Chiaia Pulse · We Chiaia</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;1,6..96,500&family=Figtree:wght@400;500;600&display=swap" />
    <style>
      :root {
        --night: #0b1626; --night-2: #102038; --line: #1f3253;
        --ink: #eef2f8; --muted: #9aabc2; --amber: #e8a33d; --warm: #ffd9a0;
        --display: "Bodoni Moda", "Didot", Georgia, serif;
        --body: "Figtree", "Segoe UI", system-ui, sans-serif;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--night); color: var(--ink); font: 16px/1.6 var(--body); -webkit-font-smoothing: antialiased; }
      body::before {
        content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background:
          radial-gradient(60% 45% at 50% 0%, rgba(232,163,61,.16), transparent 70%),
          linear-gradient(180deg, rgba(11,22,38,.55), var(--night) 70%),
          url('/media/chiaia-pulse-poster.jpg') center top / cover no-repeat;
        filter: saturate(.9);
      }
      .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }
      .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
      .top b { color: var(--ink); font-weight: 600; }
      .logo { height: 42px; width: auto; display: block; }
      .hero { padding-block: clamp(28px, 7vw, 72px) 28px; text-align: center; display: grid; gap: 16px; justify-items: center; }
      .eyebrow { color: var(--amber); font-size: 13px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
      h1 { margin: 0; font: 500 clamp(52px, 10vw, 112px)/.95 var(--display); letter-spacing: -.01em; text-shadow: 0 0 40px rgba(232,163,61,.25); }
      h1 em { font-style: italic; color: var(--warm); }
      .claim { margin: 0; font: italic 500 clamp(19px, 2.6vw, 26px)/1.35 var(--display); color: var(--ink); max-width: 30ch; text-wrap: balance; }
      .sub { margin: 0; color: var(--muted); max-width: 58ch; text-wrap: balance; }
      .player { position: relative; margin-block: 18px 8px; border-radius: 14px; padding: 1px; background: linear-gradient(135deg, rgba(232,163,61,.7), rgba(31,50,83,.6) 40%, rgba(232,163,61,.35)); box-shadow: 0 30px 90px rgba(0,0,0,.55), 0 0 80px rgba(232,163,61,.12); }
      .player video { display: block; width: 100%; height: auto; border-radius: 13px; background: #000; }
      .cap { text-align: center; color: var(--muted); font-size: 13px; margin: 6px 0 0; }
      .pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-block: 44px 36px; }
      .pillar { border-top: 1px solid var(--amber); padding-top: 14px; }
      .pillar h2 { margin: 0 0 6px; font: 500 24px/1.2 var(--display); }
      .pillar p { margin: 0; color: var(--muted); }
      .date { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 6px 14px; padding: 22px 16px; border-block: 1px solid var(--line); text-align: center; }
      .date span { color: var(--muted); font-size: 14px; letter-spacing: .12em; text-transform: uppercase; }
      .date strong { font: 500 clamp(22px, 3vw, 30px)/1.2 var(--display); color: var(--warm); }
      footer { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; padding-block: 28px 40px; color: var(--muted); font-size: 13px; }
      footer a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--amber); }
      footer a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
      .note { max-width: 70ch; }
      @media (max-width: 760px) {
        .logo { height: 32px; }
        .pillars { grid-template-columns: 1fr; }
        .top { font-size: 11px; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="top"><img class="logo" src="/media/we-chiaia-logo.svg" alt="We Chiaia" width="190" height="45" /><span>con <b>Synapsis FW</b></span></div>

      <section class="hero">
        <span class="eyebrow">Piano di illuminazione del distretto</span>
        <h1>Chiaia <em>Pulse</em></h1>
        <p class="claim">Ogni vetrina è un battito. Insieme un quartiere vivo.</p>
        <p class="sub">Il concept della rete di luce permanente dei negozi di Chiaia, presentato ai soci di We Chiaia.</p>
      </section>

      <div class="player">
        <video controls playsinline preload="metadata" poster={poster}>
          <source src={video} type="video/mp4" />
          Il browser non riproduce il video: <a href={video}>aprilo qui</a>.
        </video>
      </div>
      <p class="cap">Video concept · 1 minuto e 23 secondi · con audio</p>

      <section class="pillars">
        {pillars.map((p) => (
          <div class="pillar">
            <h2>{p.k}</h2>
            <p>{p.t}</p>
          </div>
        ))}
      </section>

      <div class="date"><span>Verso l'America's Cup</span><strong>Louis Vuitton Cup a Napoli dal 22 maggio 2027</strong></div>

      <footer>
        <span class="note">Concept per uso interno di We Chiaia. Simulazioni della luce, schermi e totem sono indicativi. Foto dei negozi: wechiaia.it, per gentile concessione di We Chiaia; crediti completi nei titoli di coda.</span>
        <a href="/">synapsisfw.it</a>
      </footer>
    </div>
  </body>
</html>
