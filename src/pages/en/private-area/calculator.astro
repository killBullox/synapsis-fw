---
import AppLayout from '@layouts/AppLayout.astro';
---

<AppLayout
  title="Calculator — Private Area · Synapsis FW"
  description="Estimate system value and design fee."
  active="calcolatore"
>
  <header class="max-w-3xl">
    <span class="eyebrow inline-flex items-center bg-brand-orange/12 text-brand-orange">
      Estimation tool
    </span>
    <h1 class="mt-6 font-display text-[clamp(2rem,4.5vw,3.25rem)] leading-tight tracking-tight">
      Systems & fee calculator.
    </h1>
    <p class="mt-5 max-w-2xl text-balance text-base leading-relaxed text-brand-ink/70 md:text-lg">
      Enter project parameters to get an estimate of system value, design fee and Fee Waiver savings based on selected services.
    </p>
  </header>

  <div class="mt-12 grid gap-8 lg:grid-cols-12 lg:gap-12">
    <form class="space-y-8 rounded-3xl border border-brand-ink/10 bg-brand-paper p-6 md:p-8 lg:col-span-7" data-calc-form novalidate>
      <fieldset class="space-y-4">
        <legend class="text-xs font-medium uppercase tracking-[0.18em] text-brand-orange">1 · Intervention type</legend>
        <label class="block">
          <span class="block text-sm font-medium text-brand-ink/80">Building type</span>
          <select name="building_type" class="mt-2 block w-full rounded-xl border border-brand-ink/15 bg-white px-4 py-3 text-base focus:border-brand-orange focus:outline-none focus:ring-2 focus:ring-brand-orange/20" data-input>
            <option value="residenziale">Residential</option>
            <option value="direzionale">Office</option>
            <option value="commerciale">Retail</option>
            <option value="industriale">Industrial</option>
            <option value="ricettivo">Hospitality</option>
            <option value="sanitario">Healthcare</option>
          </select>
        </label>
        <label class="block">
          <span class="block text-sm font-medium text-brand-ink/80">Total surface (sqm)</span>
          <input type="number" name="surface" min="0" step="10" placeholder="e.g. 1500" class="mt-2 block w-full rounded-xl border border-brand-ink/15 bg-white px-4 py-3 text-base focus:border-brand-orange focus:outline-none focus:ring-2 focus:ring-brand-orange/20" data-input />
        </label>
      </fieldset>

      <fieldset class="space-y-4 border-t border-brand-ink/10 pt-8">
        <legend class="text-xs font-medium uppercase tracking-[0.18em] text-brand-orange">2 · Disciplines</legend>
        <p class="text-sm text-brand-ink/60">Select systems included in the project.</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {[
            { id: 'elettrico', label: 'Electrical' },
            { id: 'hvac', label: 'HVAC' },
            { id: 'illuminazione', label: 'Lighting' },
            { id: 'sicurezza', label: 'Security' },
            { id: 'smart', label: 'Smart Building' },
          ].map((d) => (
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-brand-ink/15 bg-white px-4 py-3 transition-colors has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange/5">
              <input type="checkbox" name="disciplines" value={d.id} class="h-4 w-4 rounded border-brand-ink/30 text-brand-orange focus:ring-brand-orange" data-input />
              <span class="text-sm font-medium">{d.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-brand-ink/10 pt-8">
        <legend class="text-xs font-medium uppercase tracking-[0.18em] text-brand-orange">3 · Supply scenario</legend>
        <div class="space-y-3">
          {[
            { id: 'sfw', label: 'Supply via Synapsis FW', sub: 'Fees waived + bonus %' },
            { id: 'brand', label: 'SFW prescribed brands', sub: 'Fees waived' },
            { id: 'other', label: 'Non-compliant brands', sub: 'Market rate fees + future cashback' },
          ].map((s, i) => (
            <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-brand-ink/15 bg-white px-4 py-3 transition-colors has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange/5">
              <input type="radio" name="scenario" value={s.id} checked={i === 0} class="mt-1 h-4 w-4 border-brand-ink/30 text-brand-orange focus:ring-brand-orange" data-input />
              <span>
                <span class="block text-sm font-medium">{s.label}</span>
                <span class="block text-xs text-brand-ink/55">{s.sub}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-ink px-7 py-4 text-sm font-medium text-white transition-all hover:bg-brand-orange md:w-auto">
        Calculate estimate
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </form>

    <aside class="lg:col-span-5">
      <div class="sticky top-24 space-y-6">
        <div class="rounded-3xl border border-brand-ink/10 bg-brand-ink p-7 text-brand-paper md:p-8">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-brand-orange">Result</p>
          <h2 class="mt-3 font-display text-2xl leading-tight">Project estimate</h2>
          <dl class="mt-8 space-y-6">
            <div>
              <dt class="text-xs uppercase tracking-[0.15em] text-brand-paper/55">Estimated system value</dt>
              <dd class="mt-1 font-display text-4xl leading-none tracking-tight md:text-5xl" data-result-value>€ —</dd>
            </div>
            <div class="border-t border-brand-paper/10 pt-6">
              <dt class="text-xs uppercase tracking-[0.15em] text-brand-paper/55">Design fee (list)</dt>
              <dd class="mt-1 font-display text-3xl leading-none tracking-tight md:text-4xl" data-result-fee-list>€ —</dd>
            </div>
            <div class="border-t border-brand-paper/10 pt-6">
              <dt class="text-xs uppercase tracking-[0.15em] text-brand-orange">Applied fee (Fee Waiver)</dt>
              <dd class="mt-1 font-display text-3xl leading-none tracking-tight text-brand-orange md:text-4xl" data-result-fee-applied>€ —</dd>
            </div>
            <div class="border-t border-brand-paper/10 pt-6">
              <dt class="text-xs uppercase tracking-[0.15em] text-brand-paper/55">Client savings</dt>
              <dd class="mt-1 font-display text-2xl leading-none tracking-tight md:text-3xl" data-result-savings>€ —</dd>
            </div>
          </dl>
          <p class="mt-8 text-xs leading-relaxed text-brand-paper/55">
            Indicative estimate. Final values are defined project-by-project in binding offer.
          </p>
        </div>
      </div>
    </aside>
  </div>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-calc-form]');
  const out = {
    value: document.querySelector<HTMLElement>('[data-result-value]'),
    feeList: document.querySelector<HTMLElement>('[data-result-fee-list]'),
    feeApplied: document.querySelector<HTMLElement>('[data-result-fee-applied]'),
    savings: document.querySelector<HTMLElement>('[data-result-savings]'),
  };
  const fmt = (n: number) =>
    new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);

  const RATES_PER_SQM: Record<string, number> = { elettrico: 80, hvac: 120, illuminazione: 60, sicurezza: 40, smart: 50 };
  const FEE_PERCENT_BY_BUILDING: Record<string, number> = {
    residenziale: 0.085, direzionale: 0.07, commerciale: 0.075, industriale: 0.065, ricettivo: 0.08, sanitario: 0.09,
  };
  const SCENARIO_DISCOUNT: Record<string, number> = { sfw: 1.0, brand: 1.0, other: 0.0 };

  function calculate(data: FormData) {
    const surface = Number(data.get('surface') ?? 0);
    const buildingType = String(data.get('building_type') ?? 'direzionale');
    const disciplines = data.getAll('disciplines') as string[];
    const scenario = String(data.get('scenario') ?? 'sfw');
    const ratePerSqm = disciplines.reduce((sum, d) => sum + (RATES_PER_SQM[d] ?? 0), 0);
    const value = surface * ratePerSqm;
    const feePercent = FEE_PERCENT_BY_BUILDING[buildingType] ?? 0.075;
    const feeList = value * feePercent;
    const discount = SCENARIO_DISCOUNT[scenario] ?? 0;
    const feeApplied = feeList * (1 - discount);
    const savings = feeList - feeApplied;
    if (out.value) out.value.textContent = fmt(value);
    if (out.feeList) out.feeList.textContent = fmt(feeList);
    if (out.feeApplied) out.feeApplied.textContent = fmt(feeApplied);
    if (out.savings) out.savings.textContent = fmt(savings);
  }

  form?.addEventListener('submit', (e) => { e.preventDefault(); calculate(new FormData(form)); });
  form?.addEventListener('input', () => { if (form) calculate(new FormData(form)); });
</script>
