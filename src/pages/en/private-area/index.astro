---
import AppLayout from '@layouts/AppLayout.astro';

const tools = [
  {
    title: 'Systems & fee calculator',
    description:
      'Quick estimate of system value and design fee, with Fee Waiver simulation based on selected services.',
    href: '/en/private-area/calculator/',
    cta: 'Open calculator',
    status: 'Active',
  },
];
---

<AppLayout title="Private Area — Synapsis FW" active="home">
  <header class="max-w-3xl">
    <span class="eyebrow inline-flex items-center bg-brand-orange/12 text-brand-orange">
      Internal tools
    </span>
    <h1 class="mt-6 font-display text-[clamp(2.25rem,5vw,3.75rem)] leading-tight tracking-tight">
      Welcome to your private area.
    </h1>
    <p class="mt-5 max-w-xl text-balance text-base leading-relaxed text-brand-ink/70 md:text-lg">
      Operational tools for design, supply and economic simulation. The area is evolving: new features will be added progressively.
    </p>
  </header>

  <section class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {tools.map((tool) => (
      <a
        href={tool.href}
        class="group flex flex-col rounded-3xl border border-brand-ink/10 bg-brand-paper p-7 transition-all hover:-translate-y-0.5 hover:border-brand-orange hover:shadow-xl md:p-8"
      >
        <div class="flex items-center justify-between">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-orange/10 text-brand-orange">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M4 9h16M9 14h2M13 14h2M9 17h2M13 17h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
            {tool.status}
          </span>
        </div>

        <h2 class="mt-6 font-display text-2xl leading-tight">{tool.title}</h2>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-brand-ink/65">{tool.description}</p>

        <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-brand-orange">
          {tool.cta}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1">
            <path d="M1 7h12m0 0L7 1m6 6l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </a>
    ))}

    <div class="flex flex-col rounded-3xl border border-dashed border-brand-ink/15 bg-transparent p-7 text-brand-ink/40 md:p-8">
      <span class="grid h-12 w-12 place-items-center rounded-2xl border border-dashed border-brand-ink/15">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <h2 class="mt-6 font-display text-2xl leading-tight">Coming soon</h2>
      <p class="mt-3 text-sm leading-relaxed">
        Other operational tools will be added — project management, supplier dashboard, document archive.
      </p>
    </div>
  </section>
</AppLayout>
